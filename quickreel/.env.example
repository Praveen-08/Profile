# ============================================================================
# QuickReel AI — environment configuration
#
# Copy to `.env` at the monorepo root. Every app (web/api/worker/ai-service)
# reads from this single file in local dev. In production each service gets
# its own scoped environment via the deploy platform.
#
# Adapters are env-driven: leave the "optional" blocks empty and the system
# falls back to local-disk storage + heuristic vision scoring, so the full
# pipeline runs without any third-party credentials.
# ============================================================================

# ---- Core -------------------------------------------------------------
NODE_ENV=development

# ---- Database (Postgres via docker-compose in infra/docker-compose.yml) --
DATABASE_URL="postgresql://quickreel:quickreel@localhost:5432/quickreel?schema=public"

# ---- Redis / BullMQ -----------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---- Supabase auth (required for real auth; app will not start web login
# without these, but api/worker/db pipeline work without them) -----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# JWKS endpoint used by apps/api to verify Supabase-issued JWTs.
# Defaults to `${SUPABASE_URL}/auth/v1/.well-known/jwks.json` when unset.
SUPABASE_JWKS_URL=

# ---- Storage adapter ------------------------------------------------------
# STORAGE_DRIVER=local (default, dev) | r2 (production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:4000/local-storage

# Cloudflare R2 (S3-compatible) — only required when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quickreel-media
R2_PUBLIC_BASE_URL=

# ---- Vision adapter (room detection, quality scoring) ---------------------
# When unset, packages/vision falls back to the deterministic heuristic
# adapter (sharp-based: aspect ratio, brightness, sharpness, indoor/outdoor
# hue heuristic). Room classification will report UNKNOWN/low confidence
# without a key — see packages/vision/README.md for the honest gap.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ---- AI service (Python/FastAPI — librosa beat detection) -----------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# ---- Ports ------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ---- Remotion / rendering --------------------------------------------
# Points renderMedia()/selectComposition() at the pre-installed Chromium in
# this environment instead of downloading Remotion's own Chrome-for-Testing
# build. MUST be the "headless_shell" binary, not regular chrome-linux/chrome
# — validated in this environment: modern full-Chromium builds have removed
# "old" headless mode, which is what Remotion's renderer launches with by
# default, and fail with "Old Headless mode has been removed from the Chrome
# binary." chromium_headless_shell-* is a standalone build of exactly that
# old-headless implementation and works correctly (verified with a real
# render — see packages/video-engine/README.md).
REMOTION_CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
RENDER_OUTPUT_TMP_DIR=./.data/render-tmp

# ---- NestJS <-> web shared auth check --------------------------------
API_INTERNAL_URL=http://localhost:4000
