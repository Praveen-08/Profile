{
  "name": "quickreel-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @quickreel/database run generate",
    "db:migrate": "pnpm --filter @quickreel/database run migrate:dev",
    "db:seed": "pnpm --filter @quickreel/database run seed",
    "music:synthesize": "pnpm --filter @quickreel/music-engine run synthesize"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
