# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI generation mode ---
# "placeholder" = free, deterministic sample copy, no API calls (default, use for building/testing/demos)
# "live" = real Claude API calls, costs money
AI_MODE=placeholder

# --- Anthropic (only required when AI_MODE=live) ---
ANTHROPIC_API_KEY=sk-ant-your-key
# Haiku is the low-cost default; switch to a Sonnet model for higher-quality copy once you're charging for it
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
