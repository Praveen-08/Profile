// ICT Silver Bullet indicator.
// Rules extracted from the user-supplied transcript of ICT's "Silver Bullet" teaching video;
// see docs/ict-silver-bullet-spec.md in this repo for the full Phase 1 spec, the Phase 2 state
// machine, and the one disclosed conflict between the source video and the original instruction
// (sweep timing -- resolved here via `Require Sweep Inside Killzone`, default off, matching the
// video's own worked examples).
//@version=6
indicator("ICT Silver Bullet", "ICT-SB", overlay = true,
 max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// =====================================================================================
// INPUTS
// =====================================================================================
// ---- Time windows (always New York local time; DST handled by the named timezone) ----
tz = "America/New_York"
win1On = input.bool(true, "Enable London / AM window (03:00-04:00 NY)", group = "Time windows")
win1Session = input.session("0300-0400", "Window 1 session", group = "Time windows")
win2On = input.bool(true, "Enable NY AM window (10:00-11:00 NY)", group = "Time windows")
win2Session = input.session("1000-1100", "Window 2 session", group = "Time windows")
win3On = input.bool(true, "Enable NY PM window (14:00-15:00 NY)", group = "Time windows")
win3Session = input.session("1400-1500", "Window 3 session", group = "Time windows")
invalidateOnWindowClose = input.bool(true, "Invalidate pending setup when window closes", group = "Time windows")
restrictToKillzone = input.bool(true, "Only draw sweep/timeout signals inside killzone windows", group = "Time windows",
 tooltip = "Only ENTRY is required to happen inside an active killzone window -- BOS, displacement and FVG/OB can form any time before it (matching the video: liquidity/BOS/FVG build the setup, the killzone is when you act on it). This toggle just hides raw liquidity sweeps and sweep-timeout invalidations that occur outside a window -- those are the two label types that can otherwise appear all day, since the underlying model allows a sweep's bias/context to form before the window (see docs/ict-silver-bullet-spec.md).")

// ---- Display range ----
lookbackDays = input.int(30, "History to display (days, 0 = show all)", minval = 0, group = "Display range",
 tooltip = "Limits how far back labels/zones are drawn. Does not affect the underlying calculations, which always use full history for accuracy -- only what's rendered on the chart.")

// ---- Liquidity sources (all the "draws on liquidity" named in the video) ----
useSwingHL   = input.bool(true, "Swing highs/lows", group = "Liquidity sources")
swingLeft    = input.int(5, "Swing lookback (left bars)", minval = 1, group = "Liquidity sources")
swingRight   = input.int(5, "Pivot strength (right/confirm bars)", minval = 1, group = "Liquidity sources")
useEqualHL   = input.bool(true, "Relative equal highs/lows", group = "Liquidity sources")
eqTolAtrFrac = input.float(0.15, "Equal H/L tolerance (x ATR)", minval = 0.01, group = "Liquidity sources")
usePrevDayHL = input.bool(true, "Previous day high/low", group = "Liquidity sources")
usePrevWeekHL = input.bool(true, "Previous week high/low", group = "Liquidity sources")
useNYHL      = input.bool(true, "Previous NY session high/low", group = "Liquidity sources")
useTokyoHL   = input.bool(true, "Previous Tokyo session high/low", group = "Liquidity sources")
useLondonHL  = input.bool(true, "Previous London session high/low", group = "Liquidity sources")
useNWOG      = input.bool(false, "New Week Opening Gap", group = "Liquidity sources")
useFvgTarget = input.bool(true, "Fair Value Gap / inefficiency as a target", group = "Liquidity sources")

// ---- Session H/L lines (merged from the FeraTrading Sessions High/Low indicator) ----
// Shows the PREVIOUS completed session's high/low as an extending line + label -- exactly the
// same visual as that script -- and feeds those same levels into the liquidity targets above.
nySession     = input.session("0930-1700", "NY session time (NY time)", group = "Session H/L")
tokyoSession  = input.session("1700-0200", "Tokyo session time (NY time)", group = "Session H/L")
londonSession = input.session("0200-0700", "London session time (NY time)", group = "Session H/L")
nyColor       = input.color(color.lime,   "NY session color",     group = "Session H/L")
tokyoColor    = input.color(color.aqua,   "Tokyo session color",  group = "Session H/L")
londonColor   = input.color(color.orange, "London session color", group = "Session H/L")
lineExtender  = input.int(20, "Line extender (bars)", minval = 0, group = "Session H/L")
showSessionLabels = input.bool(true, "Show session labels", group = "Session H/L")
sessionLabelColor = input.color(color.white, "Session label color", group = "Session H/L")

// ---- Sweep ----
sweepConfirm = input.string("Wick", "Sweep confirmation", options = ["Wick", "Close"], group = "Sweep")
sweepLookback = input.int(120, "Sweep lookback for BOS pairing (bars)", minval = 1, group = "Sweep")
requireSweepInsideKZ = input.bool(false, "Require sweep inside the killzone (strict reading)", group = "Sweep",
 tooltip = "Off (default) matches the video's worked examples: the sweep establishing bias/draw can occur before the 60-minute window. On forces the sweep itself to occur inside the window, per the original instruction's literal sequence.")

// ---- BOS ----
bosConfirm = input.string("Close", "BOS confirmation", options = ["Wick", "Close"], group = "BOS")
maxBarsSweepToBOS = input.int(60, "Max bars: sweep -> BOS", minval = 1, group = "BOS")

// ---- Displacement ----
requireDisplacementFilter = input.bool(true, "Require additional displacement strength filter", group = "Displacement",
 tooltip = "The video's own evidence for displacement is simply that the BOS leg produces a qualifying FVG (always required). This adds an extra, optional ATR/body-% strength test on top of that.")
dispAtrMult = input.float(1.2, "Displacement ATR multiplier", minval = 0.1, group = "Displacement")
dispMinBodyPct = input.float(50, "Minimum body % of range", minval = 1, maxval = 100, group = "Displacement")
atrLen = input.int(14, "ATR length", minval = 1, group = "Displacement")

// ---- FVG ----
minFvgSizeAtrFrac = input.float(0.1, "Minimum FVG size (x ATR)", minval = 0, group = "FVG")
ignoreTinyFvg = input.bool(true, "Ignore FVGs under minimum size", group = "FVG")
maxBarsZoneToRetrace = input.int(60, "Max bars: zone -> retracement", minval = 1, group = "FVG")

// ---- Order block ----
useOB = input.bool(false, "Detect order blocks (not used in this video's examples)", group = "Order block")

// ---- Entry ----
entryZoneMode = input.string("FVG", "Entry zone", options = ["FVG", "OB", "Either"], group = "Entry")

// ---- Target ----
targetMode = input.string("Liquidity", "Target mode", options = ["Liquidity", "R:R", "Both"], group = "Target / framework")
targetRR = input.float(2.0, "Target R:R (if R:R or Both)", minval = 0.1, step = 0.25, group = "Target / framework")
instrumentType = input.string("Forex", "Instrument type", options = ["Forex", "Index Futures/Other"], group = "Target / framework")
minFrameworkPips = input.float(15, "Minimum framework (pips, Forex)", minval = 0, group = "Target / framework")
minFrameworkPoints = input.float(10, "Minimum framework (points, Index Futures/Other)", minval = 0, group = "Target / framework")
pipSizeOverride = input.float(0, "Manual pip size override (0 = auto: mintick x 10)", minval = 0, group = "Target / framework")

// ---- Risk (display only -- this is an indicator, not a strategy) ----
stopMethod = input.string("Zone edge", "Stop method", options = ["Zone edge", "Swing point"], group = "Risk")
stopBufferAtrMult = input.float(0.15, "Stop buffer beyond level (x ATR)", minval = 0, group = "Risk")

// ---- Visuals ----
showLiquidity    = input.bool(true, "Show liquidity levels", group = "Visuals")
showSweep        = input.bool(true, "Show sweeps", group = "Visuals")
showBOS          = input.bool(true, "Show BOS", group = "Visuals")
showDisplacement = input.bool(false, "Show displacement", group = "Visuals")
showFVG          = input.bool(true, "Show FVG zones", group = "Visuals")
showOB           = input.bool(true, "Show OB zones", group = "Visuals")
showEntry        = input.bool(true, "Show entries", group = "Visuals")
showTarget       = input.bool(true, "Show targets", group = "Visuals")
showInvalidation = input.bool(false, "Show invalidations", group = "Visuals")
showDashboard    = input.bool(true, "Show dashboard", group = "Visuals")
showDebug        = input.bool(false, "Show debug reasoning labels", group = "Visuals")
showKillzoneBg   = input.bool(false, "Shade active killzone windows on chart", group = "Visuals")
showKillzoneLines = input.bool(true, "Show killzone start/end vertical lines", group = "Visuals")
showSilverBulletBanner = input.bool(true, "Show \"SILVER BULLET ZONE\" banner", group = "Visuals")

// ---- Colours ----
colLiquidity    = color.new(color.yellow, 40)
colBull         = color.green
colBear         = color.red
colBOS          = color.blue
colFVGbull      = color.new(color.aqua, 40)
colFVGbear      = color.new(color.fuchsia, 40)
colOBbull       = color.new(color.teal, 50)
colOBbear       = color.new(color.maroon, 50)
colEntry        = color.new(color.yellow, 0)
colTarget       = color.new(color.green, 0)
colInvalid      = color.new(color.red, 0)
colDebug        = color.new(color.gray, 60)

// =====================================================================================
// SESSION WINDOWS
// =====================================================================================
win1Active = win1On and not na(time(timeframe.period, win1Session, tz))
win2Active = win2On and not na(time(timeframe.period, win2Session, tz))
win3Active = win3On and not na(time(timeframe.period, win3Session, tz))
anyWindowActive = win1Active or win2Active or win3Active
activeWindowName = win1Active ? "London/AM" : win2Active ? "NY AM" : win3Active ? "NY PM" : "none"

bgcolor(showKillzoneBg and anyWindowActive ? color.new(color.blue, 92) : na, title = "Killzone shading")

// ---- Display range / killzone-only display gates ----
withinLookback = lookbackDays <= 0 or time >= timenow - lookbackDays * 86400000
showKZ = not restrictToKillzone or anyWindowActive

// ---- Killzone start/end vertical lines + "SILVER BULLET ZONE" banner ----
if showKillzoneLines and withinLookback and anyWindowActive and not anyWindowActive[1]
    line.new(bar_index, close, bar_index, close + 1, color = color.new(color.gray, 40), style = line.style_dashed, extend = extend.both)
if showKillzoneLines and withinLookback and not anyWindowActive and anyWindowActive[1]
    line.new(bar_index, close, bar_index, close + 1, color = color.new(color.gray, 40), style = line.style_dashed, extend = extend.both)

var int   kzBannerStartBar = na
var float kzBannerLow = na
var label kzBannerLbl = na
var bool  setupAttemptedThisWindow = false
if anyWindowActive
    if not anyWindowActive[1]
        kzBannerStartBar := bar_index
        kzBannerLow := low
    else
        kzBannerLow := math.min(kzBannerLow, low)
    if showSilverBulletBanner and withinLookback
        label.delete(kzBannerLbl)
        kzBannerLbl := label.new(int(math.avg(kzBannerStartBar, bar_index)), kzBannerLow - kzBannerLow * 0.0006, "SILVER BULLET ZONE", color = color.new(color.black, 15), textcolor = color.white, style = label.style_label_up, size = size.normal)
// Reset "one attempt" tracking the moment a window CLOSES (not when it opens) -- this is what
// lets a sweep/BOS/FVG that forms in the gap *before* the next window (e.g. up to an hour prior)
// still count as a fresh attempt for that upcoming window, instead of being blocked by whatever
// happened in the previous window.
if not anyWindowActive and anyWindowActive[1]
    setupAttemptedThisWindow := false

// =====================================================================================
// ATR / pip size
// =====================================================================================
atrVal = ta.atr(atrLen)
pipSize = pipSizeOverride != 0 ? pipSizeOverride : syminfo.mintick * 10
requiredFrameworkDist = instrumentType == "Forex" ? minFrameworkPips * pipSize : minFrameworkPoints

// =====================================================================================
// LIQUIDITY: swing highs/lows (confirmed pivots -- inherently lag swingRight bars, disclosed,
// not repainting)
// =====================================================================================
ph = ta.pivothigh(swingLeft, swingRight)
pl = ta.pivotlow(swingLeft, swingRight)

var float lastSwingHigh = na
var int   lastSwingHighBar = na
var float prevSwingHigh = na
var float lastSwingLow = na
var int   lastSwingLowBar = na
var float prevSwingLow = na

if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph
    lastSwingHighBar := bar_index - swingRight
if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl
    lastSwingLowBar := bar_index - swingRight

if showLiquidity and not na(ph) and withinLookback
    line.new(lastSwingHighBar, ph, bar_index, ph, color = colLiquidity, style = line.style_dotted)
if showLiquidity and not na(pl) and withinLookback
    line.new(lastSwingLowBar, pl, bar_index, pl, color = colLiquidity, style = line.style_dotted)

// Relative equal highs/lows: last two confirmed swing pivots of the same type within tolerance
eqTol = atrVal * eqTolAtrFrac
eqHigh = useEqualHL and not na(lastSwingHigh) and not na(prevSwingHigh) and math.abs(lastSwingHigh - prevSwingHigh) <= eqTol ? math.max(lastSwingHigh, prevSwingHigh) : na
eqLow  = useEqualHL and not na(lastSwingLow)  and not na(prevSwingLow)  and math.abs(lastSwingLow  - prevSwingLow)  <= eqTol ? math.min(lastSwingLow, prevSwingLow)   : na

// =====================================================================================
// LIQUIDITY: previous day / previous week / session ranges / NWOG
// =====================================================================================
prevDayHigh  = usePrevDayHL  ? request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_off) : na
prevDayLow   = usePrevDayHL  ? request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_off) : na
prevWeekHigh = usePrevWeekHL ? request.security(syminfo.tickerid, "W", high[1],  lookahead = barmerge.lookahead_off) : na
prevWeekLow  = usePrevWeekHL ? request.security(syminfo.tickerid, "W", low[1],   lookahead = barmerge.lookahead_off) : na

// Previous NY/Tokyo/London session high/low, drawn as an extending line + label -- same visual
// as the FeraTrading Sessions High/Low indicator. All three sessions reset together at 18:00 NY
// (the standard forex day rollover), matching that script's day-boundary logic.
isNewDay = not na(time(timeframe.period, "1800-1801", tz))

f_sessionHL(sessActive, resetNow, lineCol, hiTxt, loTxt) =>
    var float curHigh = na
    var float curLow = na
    var int   curHighBar = na
    var int   curLowBar = na
    var float prevHigh = na
    var float prevLow = na
    var int   prevHighBar = na
    var int   prevLowBar = na
    var line  hiLine = na
    var line  loLine = na
    var label hiLbl = na
    var label loLbl = na

    if resetNow
        prevHigh := curHigh
        prevLow := curLow
        prevHighBar := curHighBar
        prevLowBar := curLowBar
        curHigh := na
        curLow := na
        curHighBar := na
        curLowBar := na
        line.delete(hiLine)
        line.delete(loLine)
        hiLine := na
        loLine := na

    if sessActive
        if na(curHigh) or high > curHigh
            curHigh := high
            curHighBar := bar_index
        if na(curLow) or low < curLow
            curLow := low
            curLowBar := bar_index

    if not na(prevHigh)
        if na(hiLine)
            hiLine := line.new(prevHighBar, prevHigh, bar_index, prevHigh, color = lineCol)
        line.set_xy2(hiLine, bar_index + lineExtender, prevHigh)
        if showSessionLabels
            label.delete(hiLbl)
            hiLbl := label.new(bar_index + lineExtender, prevHigh, hiTxt, style = label.style_label_left, color = color.new(lineCol, 0), textcolor = sessionLabelColor, size = size.tiny)
    if not na(prevLow)
        if na(loLine)
            loLine := line.new(prevLowBar, prevLow, bar_index, prevLow, color = lineCol)
        line.set_xy2(loLine, bar_index + lineExtender, prevLow)
        if showSessionLabels
            label.delete(loLbl)
            loLbl := label.new(bar_index + lineExtender, prevLow, loTxt, style = label.style_label_left, color = color.new(lineCol, 0), textcolor = sessionLabelColor, size = size.tiny)

    [prevHigh, prevLow]

nyActive     = not na(time(timeframe.period, nySession, tz))
tokyoActive  = not na(time(timeframe.period, tokyoSession, tz))
londonActive = not na(time(timeframe.period, londonSession, tz))

[prevNYHigh, prevNYLow]         = f_sessionHL(nyActive, isNewDay, nyColor, "NY High", "NY Low")
[prevTokyoHigh, prevTokyoLow]   = f_sessionHL(tokyoActive, isNewDay, tokyoColor, "Tokyo High", "Tokyo Low")
[prevLondonHigh, prevLondonLow] = f_sessionHL(londonActive, isNewDay, londonColor, "London High", "London Low")

var float nwogTop = na
var float nwogBot = na
newWeek = ta.change(time("W")) != 0
if useNWOG and newWeek
    nwogTop := math.max(open, close[1])
    nwogBot := math.min(open, close[1])

// =====================================================================================
// LIQUIDITY: FVG-as-target tracking (independent of the entry-zone state machine below --
// this tracks the most recent unfilled FVG on each side as a candidate draw on liquidity)
// =====================================================================================
bullFVGraw = low > high[2]
bearFVGraw = high < low[2]

var float lastBullFvgTop = na
var float lastBullFvgBot = na
var bool  lastBullFvgFilled = true
var float lastBearFvgTop = na
var float lastBearFvgBot = na
var bool  lastBearFvgFilled = true

if bullFVGraw
    lastBullFvgTop := low
    lastBullFvgBot := high[2]
    lastBullFvgFilled := false
if not lastBullFvgFilled and not na(lastBullFvgBot) and low < lastBullFvgBot
    lastBullFvgFilled := true

if bearFVGraw
    lastBearFvgTop := low[2]
    lastBearFvgBot := high
    lastBearFvgFilled := false
if not lastBearFvgFilled and not na(lastBearFvgTop) and high > lastBearFvgTop
    lastBearFvgFilled := true

// =====================================================================================
// NEAREST-LEVEL HELPERS (the "which draw to favor" [DECISION]: nearest qualifying level)
// =====================================================================================
f_nearestAbove(refPrice) =>
    float best = na
    if useSwingHL and not na(lastSwingHigh) and lastSwingHigh > refPrice
        best := lastSwingHigh
    if useEqualHL and not na(eqHigh) and eqHigh > refPrice and (na(best) or eqHigh < best)
        best := eqHigh
    if usePrevDayHL and not na(prevDayHigh) and prevDayHigh > refPrice and (na(best) or prevDayHigh < best)
        best := prevDayHigh
    if usePrevWeekHL and not na(prevWeekHigh) and prevWeekHigh > refPrice and (na(best) or prevWeekHigh < best)
        best := prevWeekHigh
    if useNYHL and not na(prevNYHigh) and prevNYHigh > refPrice and (na(best) or prevNYHigh < best)
        best := prevNYHigh
    if useTokyoHL and not na(prevTokyoHigh) and prevTokyoHigh > refPrice and (na(best) or prevTokyoHigh < best)
        best := prevTokyoHigh
    if useLondonHL and not na(prevLondonHigh) and prevLondonHigh > refPrice and (na(best) or prevLondonHigh < best)
        best := prevLondonHigh
    if useNWOG and not na(nwogTop) and nwogTop > refPrice and (na(best) or nwogTop < best)
        best := nwogTop
    if useFvgTarget and not lastBullFvgFilled and not na(lastBullFvgBot) and lastBullFvgBot > refPrice and (na(best) or lastBullFvgBot < best)
        best := lastBullFvgBot
    best

f_nearestBelow(refPrice) =>
    float best = na
    if useSwingHL and not na(lastSwingLow) and lastSwingLow < refPrice
        best := lastSwingLow
    if useEqualHL and not na(eqLow) and eqLow < refPrice and (na(best) or eqLow > best)
        best := eqLow
    if usePrevDayHL and not na(prevDayLow) and prevDayLow < refPrice and (na(best) or prevDayLow > best)
        best := prevDayLow
    if usePrevWeekHL and not na(prevWeekLow) and prevWeekLow < refPrice and (na(best) or prevWeekLow > best)
        best := prevWeekLow
    if useNYHL and not na(prevNYLow) and prevNYLow < refPrice and (na(best) or prevNYLow > best)
        best := prevNYLow
    if useTokyoHL and not na(prevTokyoLow) and prevTokyoLow < refPrice and (na(best) or prevTokyoLow > best)
        best := prevTokyoLow
    if useLondonHL and not na(prevLondonLow) and prevLondonLow < refPrice and (na(best) or prevLondonLow > best)
        best := prevLondonLow
    if useNWOG and not na(nwogBot) and nwogBot < refPrice and (na(best) or nwogBot > best)
        best := nwogBot
    if useFvgTarget and not lastBearFvgFilled and not na(lastBearFvgTop) and lastBearFvgTop < refPrice and (na(best) or lastBearFvgTop > best)
        best := lastBearFvgTop
    best

watchHigh = f_nearestAbove(close)
watchLow  = f_nearestBelow(close)

// =====================================================================================
// SWEEP
// =====================================================================================
sweepHighRaw = not na(watchHigh) and (sweepConfirm == "Wick" ? (high > watchHigh and close < watchHigh) : (close[1] > watchHigh and close < watchHigh))
sweepLowRaw  = not na(watchLow)  and (sweepConfirm == "Wick" ? (low  < watchLow  and close > watchLow)  : (close[1] < watchLow  and close > watchLow))
// Note: these two are "raw" -- true on every qualifying wick-rejection, even while a setup is
// already being tracked. The SWEEP label is only drawn on the bar that actually arms a NEW
// setup (see armHigh/armLow below), not on every raw occurrence -- otherwise minor rejections
// during an already-pending setup each drew their own label.

// =====================================================================================
// STATE MACHINE
// state: 0 none, 1 liquidity, 2 swept, 3 bos, 4 displacement/fvg, 5 target validated,
//        6 retrace armed, 7 entered, 8 done
// dir: 1 = bullish setup, -1 = bearish setup
// =====================================================================================
var int   state = 0
var int   dir = 0
var int   sweepBar = na
var float sweptLevel = na
var float zoneTop = na
var float zoneBot = na
var string zoneType = ""
var int   zoneBar = na
var bool  zoneClosedOutside = false
var box   zoneBox = na
var label zoneLbl = na
var float targetLevel = na
var float rrTargetLevel = na
var float stopLevel = na
var float entryLevel = na
var int   entryBar = na

// ---- arm on sweep (once per killzone window -- see setupAttemptedThisWindow below) ----
armHigh = state == 0 and not setupAttemptedThisWindow and sweepHighRaw and (not requireSweepInsideKZ or anyWindowActive)
armLow  = state == 0 and not setupAttemptedThisWindow and sweepLowRaw  and (not requireSweepInsideKZ or anyWindowActive)

if armHigh
    state := 2
    dir := -1
    sweepBar := bar_index
    sweptLevel := watchHigh
    setupAttemptedThisWindow := true
if armLow
    state := 2
    dir := 1
    sweepBar := bar_index
    sweptLevel := watchLow
    setupAttemptedThisWindow := true

if showSweep and armHigh and withinLookback and showKZ
    label.new(bar_index, high, "SWEEP", color = colInvalid, style = label.style_label_down, textcolor = color.white, size = size.tiny)
if showSweep and armLow and withinLookback and showKZ
    label.new(bar_index, low, "SWEEP", color = colBull, style = label.style_label_up, textcolor = color.white, size = size.tiny)

// ---- sweep -> BOS timeout ----
if state == 2 and bar_index - sweepBar > maxBarsSweepToBOS
    if showInvalidation and withinLookback and showKZ
        label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(no BOS)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
    state := 0
    dir := 0

// ---- BOS check (only within sweepLookback of the sweep -- NOT window-gated: per the video's
// worked examples, BOS/displacement/FVG build the setup and can happen before the killzone opens;
// only the entry itself is required to land inside the window, see touchedZone below) ----
bosUp   = dir == 1  and state == 2 and not na(lastSwingHigh) and (bar_index - sweepBar) <= sweepLookback and (bosConfirm == "Wick" ? high > lastSwingHigh : close > lastSwingHigh)
bosDown = dir == -1 and state == 2 and not na(lastSwingLow)  and (bar_index - sweepBar) <= sweepLookback and (bosConfirm == "Wick" ? low  < lastSwingLow  : close < lastSwingLow)

if bosUp or bosDown
    state := 3
    if showBOS and withinLookback
        bosFromBar = bosUp ? lastSwingHighBar : lastSwingLowBar
        bosLevel = bosUp ? lastSwingHigh : lastSwingLow
        line.new(bosFromBar, bosLevel, bar_index, bosLevel, color = colBOS, style = line.style_arrow_right, width = 2)
        label.new(int(math.avg(bosFromBar, bar_index)), bosLevel, "BOS", color = color(na), textcolor = colBOS, style = bosUp ? label.style_label_down : label.style_label_up, size = size.small)

// ---- Displacement + FVG on the BOS leg (video-grounded: FVG on the BOS leg IS the evidence) ----
dispStrengthOk = not requireDisplacementFilter or ((high - low) >= atrVal * dispAtrMult and math.abs(close - open) / (high - low) * 100 >= dispMinBodyPct)
fvgSizeOk = not ignoreTinyFvg or (bosUp and (low - high[2]) >= atrVal * minFvgSizeAtrFrac) or (bosDown and (low[2] - high) >= atrVal * minFvgSizeAtrFrac)

if state == 3 and bosUp
    if bullFVGraw and dispStrengthOk and fvgSizeOk and (entryZoneMode == "FVG" or entryZoneMode == "Either")
        zoneTop := low
        zoneBot := high[2]
        zoneType := "FVG"
        zoneBar := bar_index
        zoneClosedOutside := false
        state := 4
        if showDisplacement and withinLookback
            label.new(bar_index, low, "DISPLACEMENT", color = colBull, style = label.style_label_up, textcolor = color.white, size = size.tiny)
    else if useOB and (entryZoneMode == "OB" or entryZoneMode == "Either") and close[1] < open[1]
        zoneTop := high[1]
        zoneBot := low[1]
        zoneType := "OB"
        zoneBar := bar_index
        zoneClosedOutside := false
        state := 4
        if showDisplacement and withinLookback
            label.new(bar_index, low, "DISPLACEMENT", color = colBull, style = label.style_label_up, textcolor = color.white, size = size.tiny)
    else
        if showInvalidation and withinLookback
            label.new(bar_index, high, "SETUP INVALIDATED\n(no FVG/OB)", color = colInvalid, style = label.style_label_down, textcolor = color.white, size = size.tiny)
        state := 0
        dir := 0

if state == 3 and bosDown
    if bearFVGraw and dispStrengthOk and fvgSizeOk and (entryZoneMode == "FVG" or entryZoneMode == "Either")
        zoneTop := low[2]
        zoneBot := high
        zoneType := "FVG"
        zoneBar := bar_index
        zoneClosedOutside := false
        state := 4
        if showDisplacement and withinLookback
            label.new(bar_index, high, "DISPLACEMENT", color = colBear, style = label.style_label_down, textcolor = color.white, size = size.tiny)
    else if useOB and (entryZoneMode == "OB" or entryZoneMode == "Either") and close[1] > open[1]
        zoneTop := high[1]
        zoneBot := low[1]
        zoneType := "OB"
        zoneBar := bar_index
        zoneClosedOutside := false
        state := 4
        if showDisplacement and withinLookback
            label.new(bar_index, high, "DISPLACEMENT", color = colBear, style = label.style_label_down, textcolor = color.white, size = size.tiny)
    else
        if showInvalidation and withinLookback
            label.new(bar_index, low, "SETUP INVALIDATED\n(no FVG/OB)", color = colInvalid, style = label.style_label_up, textcolor = color.white, size = size.tiny)
        state := 0
        dir := 0

// ---- draw the zone: created once, then extended right each bar while the setup is still
// live (state 4-6). Freezes at its last width once the setup enters/invalidates so it doesn't
// keep stretching forever after the fact -- matches how ICT-style FVG/OB zones are normally drawn.
if state >= 4 and zoneBar == bar_index and withinLookback
    zoneLabel = (dir == 1 ? "FVG - BUY Zone" : "FVG - SELL Zone")
    if showFVG and zoneType == "FVG"
        zoneBox := box.new(zoneBar - 2, zoneTop, bar_index, zoneBot, border_color = dir == 1 ? colFVGbull : colFVGbear, bgcolor = dir == 1 ? colFVGbull : colFVGbear)
        zoneLbl := label.new(bar_index, math.avg(zoneTop, zoneBot), zoneLabel, color = color.new(color.black, 15), textcolor = color.white, style = label.style_label_center, size = size.small)
    if showOB and zoneType == "OB"
        zoneBox := box.new(zoneBar - 1, zoneTop, bar_index, zoneBot, border_color = dir == 1 ? colOBbull : colOBbear, bgcolor = dir == 1 ? colOBbull : colOBbear)
        zoneLbl := label.new(bar_index, math.avg(zoneTop, zoneBot), dir == 1 ? "OB - BUY Zone" : "OB - SELL Zone", color = color.new(color.black, 15), textcolor = color.white, style = label.style_label_center, size = size.small)

if state >= 4 and state < 7 and not na(zoneBox) and withinLookback
    box.set_right(zoneBox, bar_index)
    label.set_x(zoneLbl, int(math.avg(zoneBar, bar_index)))

// ---- Target validation: must clear minimum framework ----
if state == 4
    refEdge = dir == 1 ? zoneTop : zoneBot
    float candidateTarget = dir == 1 ? f_nearestAbove(refEdge) : f_nearestBelow(refEdge)
    float dist = na(candidateTarget) ? na : math.abs(candidateTarget - refEdge)
    frameworkOk = targetMode == "R:R" ? true : (not na(dist) and dist >= requiredFrameworkDist)
    if frameworkOk
        targetLevel := candidateTarget
        state := 5
    else
        if showInvalidation and withinLookback
            label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(framework too small)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
        state := 0
        dir := 0

// ---- arm for retracement once price closes back outside the zone (must be a later bar than
// the zone itself -- otherwise the forming bar's own close, which is always >= its own low,
// would immediately satisfy "closed outside" and let state cascade 4->5->6->entry in one bar) ----
if state == 5 and not zoneClosedOutside and bar_index > zoneBar
    outside = dir == 1 ? close > zoneTop : close < zoneBot
    if outside
        zoneClosedOutside := true
        state := 6

zoneFilled = state >= 5 and state < 8 and (dir == 1 ? low < zoneBot : high > zoneTop)

if state >= 5 and state < 7 and (bar_index - zoneBar) > maxBarsZoneToRetrace
    if showInvalidation and withinLookback
        label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(no retracement)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
    state := 0
    dir := 0

if state >= 5 and state < 7 and zoneFilled
    if showInvalidation and withinLookback
        label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(zone filled)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
    state := 0
    dir := 0

// Edge-triggered (window just closed), not level-triggered -- a zone that formed BEFORE its
// window opened must not get invalidated for simply not being in a window yet. It only expires
// once a window it actually had the chance to be entered in has come and gone.
if invalidateOnWindowClose and state >= 3 and state < 7 and anyWindowActive[1] and not anyWindowActive
    if showInvalidation and withinLookback
        label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(window closed)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
    state := 0
    dir := 0

// =====================================================================================
// SCORING (transparent checklist, not a black box) -- computed before the entry check below
// so the grade is available the instant an entry fires
// =====================================================================================
scoreWindow  = anyWindowActive
scoreSweep   = state >= 2
scoreBOS     = state >= 3
scoreDisp    = state >= 4
scoreZone    = state >= 4 and zoneType != ""
scoreRetrace = state >= 6
scoreTarget  = state >= 5 and not na(targetLevel)
scoreCount = (scoreWindow ? 1 : 0) + (scoreSweep ? 1 : 0) + (scoreBOS ? 1 : 0) + (scoreDisp ? 1 : 0) + (scoreZone ? 1 : 0) + (scoreRetrace ? 1 : 0) + (scoreTarget ? 1 : 0)
scoreGrade = scoreCount == 7 ? "A+ SETUP" : scoreCount >= 5 ? "A SETUP" : state >= 4 ? "B SETUP" : "NO TRADE"

// ---- entry: price retraces back into the zone -- this is the one step required to happen
// inside an active killzone window, even though BOS/FVG could have formed well before it ----
touchedZone = state == 6 and anyWindowActive and (dir == 1 ? (low <= zoneTop and low >= zoneBot) : (high >= zoneBot and high <= zoneTop))
if touchedZone
    entryLevel := dir == 1 ? zoneTop : zoneBot
    entryBar := bar_index
    bufAtr = atrVal * stopBufferAtrMult
    stopLevel := stopMethod == "Zone edge" ? (dir == 1 ? zoneBot - bufAtr : zoneTop + bufAtr) : (dir == 1 ? sweptLevel - bufAtr : sweptLevel + bufAtr)
    riskUnit = math.abs(entryLevel - stopLevel)
    rrTargetLevel := dir == 1 ? entryLevel + riskUnit * targetRR : entryLevel - riskUnit * targetRR
    state := 7
    finalTargetLevel = targetMode == "R:R" ? rrTargetLevel : targetLevel
    if showEntry and withinLookback
        label.new(bar_index, entryLevel,
         (dir == 1 ? "BUY " : "SELL ") + str.tostring(entryLevel, format.mintick) +
         "\nStop " + str.tostring(stopLevel, format.mintick) +
         "\nTarget " + (na(finalTargetLevel) ? "n/a" : str.tostring(finalTargetLevel, format.mintick)) +
         "\n" + scoreGrade + " (" + str.tostring(scoreCount) + "/7)",
         color = dir == 1 ? colBull : colBear, style = dir == 1 ? label.style_label_up : label.style_label_down, textcolor = color.white, size = size.small)
        line.new(bar_index, stopLevel, bar_index + 20, stopLevel, color = colInvalid, style = line.style_dashed)
        label.new(bar_index + 20, stopLevel, "STOP", color = colInvalid, textcolor = color.white, style = label.style_label_left, size = size.tiny)
    if showTarget and not na(finalTargetLevel) and withinLookback
        line.new(bar_index, finalTargetLevel, bar_index + 20, finalTargetLevel, color = colTarget, style = line.style_dashed)
        label.new(bar_index + 20, finalTargetLevel, "TARGET", color = colTarget, textcolor = color.black, style = label.style_label_left, size = size.tiny)
    if showTarget and targetMode == "Both" and not na(targetLevel) and withinLookback
        line.new(bar_index, rrTargetLevel, bar_index + 20, rrTargetLevel, color = color.new(colTarget, 60), style = line.style_dotted)

// ---- manage open setup: stop / target ----
if state == 7
    hitTarget = dir == 1 ? high >= (targetMode == "R:R" ? rrTargetLevel : targetLevel) : low <= (targetMode == "R:R" ? rrTargetLevel : targetLevel)
    hitStop   = dir == 1 ? low <= stopLevel : high >= stopLevel
    if hitTarget or hitStop
        state := 8

if state == 8
    state := 0
    dir := 0

// =====================================================================================
// DEBUG
// =====================================================================================
if showDebug and sweepHighRaw and withinLookback and showKZ
    label.new(bar_index, high, "Sweep confirmed (sell-side setup)", color = colDebug, style = label.style_label_down, size = size.tiny)
if showDebug and sweepLowRaw and withinLookback and showKZ
    label.new(bar_index, low, "Sweep confirmed (buy-side setup)", color = colDebug, style = label.style_label_up, size = size.tiny)
if showDebug and (bosUp or bosDown) and withinLookback
    label.new(bar_index, bosUp ? low : high, "BOS confirmed", color = colDebug, style = bosUp ? label.style_label_up : label.style_label_down, size = size.tiny)
if showDebug and state == 6 and state[1] != 6 and withinLookback
    label.new(bar_index, dir == 1 ? low : high, "Waiting for retracement", color = colDebug, style = dir == 1 ? label.style_label_up : label.style_label_down, size = size.tiny)

// =====================================================================================
// DASHBOARD
// =====================================================================================
var table dash = table.new(position.top_right, 2, 9, border_width = 1)

f_dash(_row, _label, _val, _valColor) =>
    table.cell(dash, 0, _row, _label, text_halign = text.align_left,  bgcolor = color.new(color.gray, 80), text_color = color.white)
    table.cell(dash, 1, _row, _val,   text_halign = text.align_right, bgcolor = color.new(color.gray, 80), text_color = _valColor)

if showDashboard and barstate.islast
    f_dash(0, "SILVER BULLET", "", color.white)
    f_dash(1, "Window", anyWindowActive ? activeWindowName : "inactive", anyWindowActive ? color.lime : color.gray)
    f_dash(2, "Sweep", scoreSweep ? "OK" : "-", scoreSweep ? color.lime : color.gray)
    f_dash(3, "BOS", scoreBOS ? "OK" : "-", scoreBOS ? color.lime : color.gray)
    f_dash(4, "Displacement", scoreDisp ? "OK" : "-", scoreDisp ? color.lime : color.gray)
    f_dash(5, "FVG/OB", scoreZone ? zoneType : "-", scoreZone ? color.lime : color.gray)
    f_dash(6, "Retracement", state == 6 ? "WAITING" : state >= 7 ? "OK" : "-", state >= 6 ? color.lime : color.gray)
    f_dash(7, "Target", scoreTarget ? "OK" : "-", scoreTarget ? color.lime : color.gray)
    statusTxt = state == 7 ? "SILVER BULLET " + (dir == 1 ? "LONG" : "SHORT") : state >= 4 ? "WAITING FOR ENTRY" : state >= 2 ? "TRACKING SETUP" : "NO SETUP"
    f_dash(8, "STATUS", statusTxt, state == 7 ? (dir == 1 ? color.lime : color.red) : color.orange)

// =====================================================================================
// ALERTS
// =====================================================================================
alertcondition(armHigh or armLow, "Liquidity sweep detected", "ICT Silver Bullet: liquidity sweep detected")
alertcondition(bosUp or bosDown, "BOS confirmed", "ICT Silver Bullet: BOS confirmed")
alertcondition(state == 4 and zoneBar == bar_index, "Displacement confirmed", "ICT Silver Bullet: displacement confirmed")
alertcondition(state == 4 and zoneBar == bar_index and zoneType == "FVG", "FVG created", "ICT Silver Bullet: FVG created")
alertcondition(touchedZone, "Price entered FVG/OB", "ICT Silver Bullet: price entered the entry zone")
alertcondition(state == 7 and entryBar == bar_index, "Complete Silver Bullet setup", "ICT Silver Bullet: COMPLETE SETUP")
alertcondition(state == 7 and entryBar == bar_index, "Entry signal", "ICT Silver Bullet: entry signal")
alertcondition(state == 8, "Target reached", "ICT Silver Bullet: target or stop reached")
alertcondition(showInvalidation and (state == 0 and state[1] != 0), "Setup invalidated", "ICT Silver Bullet: setup invalidated")
