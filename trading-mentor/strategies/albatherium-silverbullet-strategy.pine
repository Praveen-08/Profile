// Original structure-mapping engine: [AlbaTherium] Structure mapping v2.0 (indicator), adapted here
// for personal backtesting only. All original structure/IDM/BoS/ChoCh detection logic is left
// byte-for-byte as authored -- the only changes are (1) indicator() -> strategy() so it can be
// backtested, and (2) a new "Silver Bullet / Killzone" entry engine appended on top of it. Every
// added block is marked "SILVER BULLET / KILLZONE MERGE" so it's obvious what's new vs. original.
//@version=6
strategy("[AlbaTherium Merge] Structure + Silver Bullet KZ", "AlbaTherium+SB", true,
 max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500,
 initial_capital = 10000,
 default_qty_type = strategy.cash,
 default_qty_value = 10000,
 commission_type = strategy.commission.percent,
 commission_value = 0.05,
 slippage = 1,
 calc_on_every_tick = false)

//#region variable declaration
var bool mnUp = na
var bool mnDn = na
float mnStrc = na
var top = high
var bot = low
var puUp = high
var puDn = low
var L = low
var H = high
var idmB = low
var idmS = high
var lastH = high
var lastL = low
var lastHH = high
var lastLL = low
//bar indexes
var int puUpbar = na
var int puDnbar = na
var int idmB_bar = na
var int idmS_bar = na
var int Hbar = bar_index
var int Lbar = bar_index
var int lastHbar = bar_index
var int lastLbar = bar_index
var int lastHHbar = bar_index
var int lastLLbar = bar_index
//structure confirmaions
lastHL = math.max(Hbar, Lbar)
var bool isBosUp = 0
var bool isBosDn = 0
var bool isCocUp = 1
var bool isCocDn = 1

//color
color transp = color.new(color.gray,100)

//drawing options
equalHL = input.bool(0,"Use equal H/L", "To calculate valid pullbacks and minor structure", group = "Calculation method")

showHL = input.bool(1, "Mark H/L", group = "H/L marking options")
HLcolor = input.color(color.gray, "H/L color", group = "H/L marking options")

showMn = input.bool(0, "Mark out internal structure", group = "Internal structue")
puUpco = input.color(color.red  , "High pivots", inline = "mnco", group = "Internal structue")
puDnco = input.color(color.green, "Low pivots" , inline = "mnco", group = "Internal structue")

showBC = input.bool(1, "Mark BoS/ChoCh", group = "BoS/Choch")
bull = input.color(color.green, "Bull color", inline = "BSclor" ,group = "BoS/Choch")
bear = input.color(color.red  , "Bear color", inline = "BSclor" ,group = "BoS/Choch")

showbarcolor = input.bool(0,"Bar color", group = "Bar color")
showSCOB = input.bool(1, "Show SCOB pattern", group = "Bar color")
scobUp = input.color(color.aqua   , "Bullish SCOB", inline = "scob" , group = "Bar color")
scobDn = input.color(color.fuchsia, "Bearish SCOB", inline = "scob" , group = "Bar color")

showIDM = input.bool(1,"Mark previous IDM", group = "IDM")
showliveIDM = input.bool(1,"Mark live IDM", group = "IDM")
idmColor = input.color(color.gray, "IDM color", group = "IDM")
var label lv_lbl = na
var line lv_line = na

showSw = input.bool(1, "Show H/L sweeping lines", group = "H/L sweeps")
markX = input.bool(1, 'Mark "X"', group = "H/L sweeps")
swColor  = input.color(color.gray, "Sweeping line color", group = "H/L sweeps")

//max line length
maxlen = bar_index - 500

// ==== SILVER BULLET / KILLZONE MERGE: new persistent state ====
// Flags set inside the ORIGINAL structure blocks below, at the exact bar an inducement (IDM)
// level gets taken out. Declared here (top of script) so they're assignable from the mid-script
// structure logic and readable later in the new entry-engine region at the bottom.
bool bullSweepEvent = false   // true on the bar price sweeps below idmB while bias is bullish
bool bearSweepEvent = false   // true on the bar price sweeps above idmS while bias is bearish
var float bullStopRef = na    // idmB level at the moment of a bullish sweep (stop reference)
var float bearStopRef = na    // idmS level at the moment of a bearish sweep (stop reference)

// Silver Bullet / killzone inputs
kzSession  = input.session("0200-0500", "Killzone window", group = "Silver Bullet / Killzone",
 tooltip = "Default = ICT London killzone, 02:00-05:00 in the timezone set below. Entries only trigger inside this window.")
kzTZ       = input.string("America/New_York", "Killzone timezone", group = "Silver Bullet / Killzone")
requireDisplacement = input.bool(true, "Require displacement candle before FVG", group = "Silver Bullet / Killzone",
 tooltip = "Middle candle of the 3-bar FVG must close in the trade direction (a real impulse, not just noise).")
maxBarsWait = input.int(30, "Max bars to wait for FVG after sweep", minval = 1, group = "Silver Bullet / Killzone",
 tooltip = "If no qualifying FVG forms within this many bars of the inducement sweep, the setup is discarded.")
oneTradePerDay = input.bool(true, "One trade per day", group = "Silver Bullet / Killzone")
allowLong  = input.bool(true, "Allow long trades", group = "Silver Bullet / Killzone")
allowShort = input.bool(true, "Allow short trades", group = "Silver Bullet / Killzone")

riskPct   = input.float(1.0, "Risk per trade (% of equity)", minval = 0.01, maxval = 100, group = "Risk model")
rMultiple = input.float(2.0, "Target R:R (reward multiple of risk)", minval = 0.1, step = 0.25, group = "Risk model",
 tooltip = "Take-profit distance = R multiple x stop distance. Vary this to find your ideal R:R.")
slBufferAtrMult = input.float(0.1, "Stop buffer beyond swept level (x ATR)", minval = 0, step = 0.05, group = "Risk model",
 tooltip = "Extra room past the swept high/low so the sweep wick itself doesn't stop you out.")
atrLenSB = input.int(14, "ATR length (stop buffer only)", minval = 1, group = "Risk model")

showFVG = input.bool(true, "Draw Silver Bullet FVGs", group = "Silver Bullet / Killzone display")
sbLongColor  = input.color(color.new(color.aqua, 70),    "Bullish FVG", inline = "sbco", group = "Silver Bullet / Killzone display")
sbShortColor = input.color(color.new(color.fuchsia, 70), "Bearish FVG", inline = "sbco", group = "Silver Bullet / Killzone display")
// ==== END new declarations ====

//#endregion

//#region drawing functions
mnMark(bool UD) =>
    if showMn
        label.new(
         x = UD ? puUpbar : puDnbar,
         y = UD ? puUp : puDn,
         yloc = UD ? yloc.abovebar : yloc.belowbar,
         text = "",
         color = UD ? puUpco : puDnco,
         style = UD ? label.style_arrowdown : label.style_arrowup,
         size = size.tiny
         )

BoS_ChoCh(bool B_C, bool UpDn) =>
    [HLbarid, BCprc, BCcolor, BCtxt, BCstyle] = switch
        B_C == 1 and UpDn == 1 => [lastHHbar, lastHH, bull, "BoS"  , label.style_label_down]
        B_C == 0 and UpDn == 1 => [lastHbar , lastH , bull, "ChoCh", label.style_label_down]
        B_C == 0 and UpDn == 0 => [lastLbar , lastL , bear, "ChoCh", label.style_label_up  ]
        B_C == 1 and UpDn == 0 => [lastLLbar, lastLL, bear, "BoS"  , label.style_label_up  ]
    HLbarid := HLbarid < maxlen ? maxlen : HLbarid
    if showBC
        line.new(HLbarid, BCprc, bar_index, BCprc, color = BCcolor, style = line.style_dashed)
        label.new(
         int( math.avg(bar_index,HLbarid) ), BCprc
          ,BCtxt
          ,color = transp
          ,style = BCstyle
          ,textcolor = BCcolor
          )

cfHL(bool ifHL) =>
    [ifHLbarid, HLprc] = switch
        ifHL =>
            [Hbar, H]
        =>
            [Lbar, L]
    ifHL_txt = if ifHL
        if H == lastHH
            "HH"
        else
            "LH"
    else
        if L == lastLL
            "LL"
        else
            "HL"
    cfHLStyle = ifHL ? label.style_label_down : label.style_label_up
    if showHL
        label.new(ifHLbarid,HLprc,ifHL_txt, color = transp, textcolor = HLcolor, style = cfHLStyle)

sweep(bool swHL, bool swHrLr) =>
    swStyle = swHL ? label.style_label_down : label.style_label_up
    [swHLbarid, swprc, swHL_txt] = switch
        swHL == 1 and swHrLr == 1 => [lastHHbar, lastHH, "HH"]
        swHL == 1 and swHrLr == 0 => [lastHbar , lastH , "LH"]
        swHL == 0 and swHrLr == 1 => [lastLbar , lastL , "HL"]
        swHL == 0 and swHrLr == 0 => [lastLLbar, lastLL, "LL"]
    swHLbarid := swHLbarid < maxlen ? maxlen : swHLbarid
    //draw sweeping line
    if showSw
        line.new(swHLbarid,swprc,bar_index,swprc,color = swColor,style = line.style_dotted)
        if markX
            label.new(int(math.avg(bar_index,swHLbarid)),swprc, "X", color = transp, textcolor = swColor, style = swStyle, size = size.small)

IDM(bool BS) =>
    IDMid = BS ? idmB_bar : idmS_bar
    idmprc = BS ? idmB : idmS
    idmStyle = BS ? label.style_label_up : label.style_label_down
    IDMid := IDMid < maxlen ? maxlen : IDMid
    //draw idm takeout line
    if showIDM
        line.new(IDMid,idmprc,bar_index,idmprc,color = idmColor,style = line.style_dotted)
        label.new(int(math.avg(bar_index,IDMid)),idmprc, "IDM", color = transp, textcolor = idmColor, style = idmStyle,size = size.small)

//Bar color
ba_color = if showSCOB
    if low[1] == puDn and low >= low[1] and close > high[1] and close[1] > low[2]
        scobUp
    else if high[1] == puUp and high <= high[1] and close < low[1] and close[1] < high[2]
        scobDn
    else if showbarcolor
        isCocUp?bull:bear
    else
        na
barcolor(ba_color,-1)
//#endregion

//#region structure mapping
//update IDM
if high > lastH
    if low < bot and close > open
        if low < idmB and lastHL != Lbar
            IDM(1)
            cfHL(1)
            isBosUp := 0
            L := low
            Lbar := bar_index
        idmB := low
        idmB_bar := bar_index
    else
        idmB := puDn
        idmB_bar := puDnbar
if low < lastL
    if high > top and close < open
        if high > idmS and lastHL != Hbar
            IDM(0)
            cfHL(0)
            isBosDn := 0
            H := high
            Hbar := bar_index
        idmS := high
        idmS_bar := bar_index
    else
        idmS := puUp
        idmS_bar := puUpbar

//Check for IDM and ChoCh
if isCocUp and lastHL != Lbar
    if low < idmB
        // SILVER BULLET / KILLZONE MERGE: this is the exact moment the original script detects a
        // bullish inducement sweep. Latch it (and the level that got swept) before idmB is
        // touched again anywhere else this bar.
        bullSweepEvent := true
        bullStopRef := idmB
        if idmB != lastL
            IDM(1)
        isBosUp := 0
        if high > lastH and close < open
            H := high
            Hbar := bar_index
        lastH := H
        lastHbar := Hbar
        lastHH := H
        lastHHbar := Hbar
        cfHL(1)
        L := low
        Lbar := bar_index
else if lastH != lastHH and high > lastH
    if close > lastH
        BoS_ChoCh(0,1)
        cfHL(0)
        isCocDn := 0
        isBosDn := 0
        isCocUp := 1
    else
        sweep(1,0)

if isCocDn and lastHL != Hbar
    if high > idmS
        // SILVER BULLET / KILLZONE MERGE: mirror of the block above for bearish inducement sweeps.
        bearSweepEvent := true
        bearStopRef := idmS
        if idmS != lastH
            IDM(0)
        isBosDn := 0
        if low < lastL and close > open
            L := low
            Lbar := bar_index
        lastL := L
        lastLbar := Lbar
        lastLL := L
        lastLLbar := Lbar
        cfHL(0)
        H := high
        Hbar := bar_index
else if low < lastL and lastL != lastLL
    if close < lastL
        BoS_ChoCh(0,0)
        cfHL(1)
        isCocDn := 1
        isCocUp := 0
        isBosUp := 0
    else
        sweep(0,1)

//Check for BoS
if isBosUp == 0
    if high > lastHH
        if close > lastHH
            BoS_ChoCh(1,1)
            cfHL(0)
            lastL := L
            lastLbar := Lbar
            isCocUp := 1
            isBosUp := 1
            isCocDn := 0
            isBosDn := 0
        else
            sweep(1,1)
if isBosDn == 0
    if low < lastLL
        if close < lastLL
            BoS_ChoCh(1,0)
            cfHL(1)
            lastH := H
            lastHbar := Hbar
            isCocUp := 0
            isBosUp := 0
            isCocDn := 1
            isBosDn := 1
        else
            sweep(0,0)
//#endregion

//#region internal structure
if high > top
    if low > bot
        mnDn :=0
    mnUp := 1
if low < bot
    if high < top
        mnUp := 0
    mnDn := 1
if mnUp[1] and not mnUp
    mnMark(1)
if mnDn[1] and not mnDn
    mnMark(0)

if high > top
    puUp := high
    puUpbar := bar_index
if low < bot
    puDn := low
    puDnbar := bar_index
    top := high
    bot := low
if high > top
    top := high
    bot := low
//#endregion

//#region auto update High and Low vars
if high > H
    H := high
    Hbar := bar_index
if high > idmS
    idmS := high
    idmS_bar := bar_index
if high > lastH
    lastH := high
    lastHbar := bar_index
if high > lastHH
    lastHH := high
    lastHHbar := bar_index

if low < L
    L := low
    Lbar := bar_index
if low < idmB
    idmB := low
    idmB_bar := bar_index
if low < lastL
    lastL := low
    lastLbar := bar_index
if low < lastLL
    lastLL := low
    lastLLbar := bar_index

//#endregion

// =====================================================================================
// SILVER BULLET / KILLZONE MERGE: entry engine
// -------------------------------------------------------------------------------------
// Everything above this line is the original AlbaTherium structure-mapping logic,
// unmodified except for the two `bullSweepEvent` / `bearSweepEvent` latches inserted
// where the script already detects an inducement (IDM) takeout.
//
// Rule being traded: while price is inside the killzone, if the current bias sweeps its
// inducement (the exact original IDM condition above), wait for a Fair Value Gap to form
// in that same direction (classic ICT Silver Bullet), then enter at market with a stop
// beyond the swept level and a target at a configurable R multiple.
// =====================================================================================
inKillzone = not na(time(timeframe.period, kzSession, kzTZ))

atrBuf = ta.atr(atrLenSB)

// 3-bar Fair Value Gap: gap between the high two bars ago and the current low (bullish),
// or the low two bars ago and the current high (bearish).
bullFVG = low > high[2] and (not requireDisplacement or close[1] > open[1])
bearFVG = high < low[2] and (not requireDisplacement or close[1] < open[1])

var bool pendingBull = false
var bool pendingBear = false
var int  pendingBullBar = na
var int  pendingBearBar = na

// Killzone closing, or bias flipping, invalidates whatever setup was pending.
if not inKillzone or not isCocUp
    pendingBull := false
if not inKillzone or not isCocDn
    pendingBear := false

// A fresh sweep (re)arms the setup.
if bullSweepEvent and inKillzone
    pendingBull := true
    pendingBullBar := bar_index
if bearSweepEvent and inKillzone
    pendingBear := true
    pendingBearBar := bar_index

// Time out a pending setup if the FVG never shows up.
if pendingBull and bar_index - pendingBullBar > maxBarsWait
    pendingBull := false
if pendingBear and bar_index - pendingBearBar > maxBarsWait
    pendingBear := false

// One trade per day
var bool tradedToday = false
newDay = ta.change(time("D")) != 0
if newDay
    tradedToday := false
canTradeToday = not oneTradePerDay or not tradedToday

longTrigger  = pendingBull and inKillzone and bullFVG and allowLong  and canTradeToday and strategy.position_size <= 0
shortTrigger = pendingBear and inKillzone and bearFVG and allowShort and canTradeToday and strategy.position_size >= 0

if showFVG and bullFVG
    box.new(bar_index[2], high[2], bar_index, low, border_color = sbLongColor, bgcolor = sbLongColor)
if showFVG and bearFVG
    box.new(bar_index[2], low[2], bar_index, high, border_color = sbShortColor, bgcolor = sbShortColor)

if longTrigger
    stopPrice = bullStopRef - atrBuf * slBufferAtrMult
    riskPerUnit = close - stopPrice
    if riskPerUnit > 0
        targetPrice = close + riskPerUnit * rMultiple
        qty = strategy.equity * riskPct / 100 / riskPerUnit
        strategy.entry("SB Long", strategy.long, qty = qty)
        strategy.exit("SB Long Exit", "SB Long", stop = stopPrice, limit = targetPrice)
        pendingBull := false
        tradedToday := true

if shortTrigger
    stopPriceS = bearStopRef + atrBuf * slBufferAtrMult
    riskPerUnitS = stopPriceS - close
    if riskPerUnitS > 0
        targetPriceS = close - riskPerUnitS * rMultiple
        qtyS = strategy.equity * riskPct / 100 / riskPerUnitS
        strategy.entry("SB Short", strategy.short, qty = qtyS)
        strategy.exit("SB Short Exit", "SB Short", stop = stopPriceS, limit = targetPriceS)
        pendingBear := false
        tradedToday := true

// ---------------------------- Stats: win rate + realized R:R + breakeven R:R ----------------------------
totalTrades = strategy.closedtrades
wins        = strategy.wintrades
losses      = strategy.losstrades

winRate    = totalTrades > 0 ? wins / totalTrades * 100 : na
avgWin     = wins   > 0 ? strategy.grossprofit / wins   : na
avgLoss    = losses > 0 ? strategy.grossloss   / losses : na
realizedRR = (not na(avgWin)) and (not na(avgLoss)) and avgLoss != 0 ? avgWin / math.abs(avgLoss) : na

wrFrac      = totalTrades > 0 ? wins / totalTrades : na
breakevenRR = (not na(wrFrac)) and wrFrac > 0 ? (1 - wrFrac) / wrFrac : na
expectancyR = (not na(wrFrac)) ? wrFrac * rMultiple - (1 - wrFrac) : na

profitFactor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na

var table perfTb = table.new(position.top_right, 2, 8, border_width = 1)

f_row(_row, _label, _val) =>
    table.cell(perfTb, 0, _row, _label, text_halign = text.align_left,  bgcolor = color.new(color.gray, 80), text_color = color.white)
    table.cell(perfTb, 1, _row, _val,   text_halign = text.align_right, bgcolor = color.new(color.gray, 80), text_color = color.white)

if barstate.islast
    f_row(0, "Closed trades",        str.tostring(totalTrades))
    f_row(1, "Win rate",             na(winRate) ? "n/a" : str.tostring(winRate, "#.##") + "%")
    f_row(2, "Target R:R (input)",   str.tostring(rMultiple, "#.##"))
    f_row(3, "Realized R:R (avg)",   na(realizedRR) ? "n/a" : str.tostring(realizedRR, "#.##"))
    f_row(4, "Breakeven R:R needed", na(breakevenRR) ? "n/a" : str.tostring(breakevenRR, "#.##"))
    f_row(5, "Expectancy",           na(expectancyR) ? "n/a" : str.tostring(expectancyR, "#.###") + " R/trade")
    f_row(6, "Profit factor",        na(profitFactor) ? "n/a" : str.tostring(profitFactor, "#.##"))
    f_row(7, "Net profit",           str.tostring(strategy.netprofit, "#.##"))

//#region live IDM
if barstate.islast
    if showliveIDM
        [liveIDM, liveIDMbar] = if isCocUp and lastHL == Hbar
            [idmB, idmB_bar]
        else if isCocDn and lastHL == Lbar
            [idmS, idmS_bar]
        lv_line := line.new(liveIDMbar, liveIDM, bar_index + 20, liveIDM, color = idmColor, style = line.style_dotted),
        lv_lbl := label.new(bar_index + 20, liveIDM, "IDM", color = transp, textcolor = idmColor, style = isCocUp ? label.style_label_down : label.style_label_up, size = size.small)
    else
        lv_line := na
        lv_lbl := na
    line.delete(lv_line[1])
    label.delete(lv_lbl[1])
//#endregion
