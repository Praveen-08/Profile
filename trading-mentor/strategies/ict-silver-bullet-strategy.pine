// ICT Silver Bullet -- BACKTEST version.
// Identical rules/state machine to strategies/ict-silver-bullet-indicator.pine (see
// docs/ict-silver-bullet-spec.md for the full spec) -- the only differences are that this is a
// strategy() so TradingView's Strategy Tester can report real win rate / P&L, orders are placed
// automatically at ENTRY with a stop and target, and a win-rate/R:R stats table is added.
// Use the indicator first to watch signals form live; switch to this once you're happy with the
// settings and want real backtest numbers.
//@version=6
strategy("ICT Silver Bullet [Backtest]", "ICT-SB-BT", overlay = true,
 max_bars_back = 5000, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500,
 initial_capital = 10000,
 default_qty_type = strategy.cash,
 default_qty_value = 10000,
 commission_type = strategy.commission.percent,
 commission_value = 0.05,
 slippage = 1,
 calc_on_every_tick = false)

// =====================================================================================
// INPUTS (unchanged from the indicator -- see its comments / the spec doc for rationale)
// =====================================================================================
tz = "America/New_York"
win1On = input.bool(true, "Enable London / AM window (03:00-04:00 NY)", group = "Time windows")
win1Session = input.session("0300-0400", "Window 1 session", group = "Time windows")
win2On = input.bool(true, "Enable NY AM window (10:00-11:00 NY)", group = "Time windows")
win2Session = input.session("1000-1100", "Window 2 session", group = "Time windows")
win3On = input.bool(true, "Enable NY PM window (14:00-15:00 NY)", group = "Time windows")
win3Session = input.session("1400-1500", "Window 3 session", group = "Time windows")
invalidateOnWindowClose = input.bool(true, "Invalidate pending setup when window closes", group = "Time windows")

useSwingHL   = input.bool(true, "Swing highs/lows", group = "Liquidity sources")
swingLeft    = input.int(5, "Swing lookback (left bars)", minval = 1, group = "Liquidity sources")
swingRight   = input.int(5, "Pivot strength (right/confirm bars)", minval = 1, group = "Liquidity sources")
useEqualHL   = input.bool(true, "Relative equal highs/lows", group = "Liquidity sources")
eqTolAtrFrac = input.float(0.15, "Equal H/L tolerance (x ATR)", minval = 0.01, group = "Liquidity sources")
usePrevDayHL = input.bool(true, "Previous day high/low", group = "Liquidity sources")
usePrevWeekHL = input.bool(true, "Previous week high/low", group = "Liquidity sources")
useNYHL      = input.bool(true, "Previous NY session high/low", group = "Liquidity sources")
useTokyoHL   = input.bool(true, "Tokyo session high/low", group = "Liquidity sources")
useLondonHL  = input.bool(true, "London session high/low", group = "Liquidity sources")
useNWOG      = input.bool(false, "New Week Opening Gap", group = "Liquidity sources")
useFvgTarget = input.bool(true, "Fair Value Gap / inefficiency as a target", group = "Liquidity sources")
useLiqCluster = input.bool(true, "Buy/sell-side liquidity clusters (LuxAlgo)", group = "Liquidity sources",
 tooltip = "Ported from LuxAlgo's ICT Concepts [LuxAlgo]: clusters 3+ nearby swing points of the same direction into a single box, marking resting buy-side/sell-side liquidity as a zone rather than one single swing line.")
liqClusterMargin = input.float(4, "Liquidity cluster margin", minval = 2, maxval = 7, step = 0.1, group = "Liquidity sources",
 tooltip = "Lower = tighter clustering (fewer, more precise clusters). Matches LuxAlgo's own 'margin' input.")
liqClusterZZLen = input.int(5, "Liquidity cluster zigzag length", minval = 3, maxval = 10, group = "Liquidity sources")
liqClusterVisBoxes = input.int(2, "Visible liquidity boxes per side", minval = 1, group = "Liquidity sources")

// ---- Session H/L lines (merged from the FeraTrading Sessions High/Low indicator) ----
nySession     = input.session("0930-1700", "NY session time (NY time)", group = "Session H/L")
tokyoSession  = input.session("1700-0200", "Tokyo session time (NY time)", group = "Session H/L")
londonSession = input.session("0200-0700", "London session time (NY time)", group = "Session H/L")
nyColor       = input.color(color.lime,   "NY session color",     group = "Session H/L")
tokyoColor    = input.color(color.aqua,   "Tokyo session color",  group = "Session H/L")
londonColor   = input.color(color.orange, "London session color", group = "Session H/L")
lineExtender  = input.int(20, "Line extender (bars)", minval = 0, group = "Session H/L")
showSessionLabels = input.bool(true, "Show session labels", group = "Session H/L")
sessionLabelColor = input.color(color.white, "Session label color", group = "Session H/L")

sweepConfirm = input.string("Wick", "Sweep confirmation", options = ["Wick", "Close"], group = "Sweep")
sweepLookback = input.int(120, "Sweep lookback for BOS pairing (bars)", minval = 1, group = "Sweep")
requireSweepInsideKZ = input.bool(false, "Require sweep inside the killzone (strict reading)", group = "Sweep")

bosConfirm = input.string("Close", "BOS confirmation", options = ["Wick", "Close"], group = "BOS")
maxBarsSweepToBOS = input.int(60, "Max bars: sweep -> BOS", minval = 1, group = "BOS")
useFastBOS = input.bool(true, "Use LuxAlgo fast zigzag for BOS reference (recommended)", group = "BOS",
 tooltip = "Ported from LuxAlgo's ICT Concepts [LuxAlgo] MSS/BOS indexing: BOS breaks against the nearest point on their fast 1-bar-confirm zigzag instead of the slower Swing lookback pivot above, which can otherwise sit many bars (even days) stale on lower-frequency structure. Off reverts to the old swing-pivot-based BOS.")

requireDisplacementFilter = input.bool(true, "Require additional displacement strength filter", group = "Displacement")
dispBodyAvgLen = input.int(5, "Body average length (bars)", minval = 1, group = "Displacement")
atrLen = input.int(14, "ATR length", minval = 1, group = "Displacement")
maxBarsBOStoFVG = input.int(5, "Max bars: BOS -> FVG/OB", minval = 0, group = "Displacement")

minFvgSizeAtrFrac = input.float(0.1, "Minimum FVG size (x ATR)", minval = 0, group = "FVG")
ignoreTinyFvg = input.bool(true, "Ignore FVGs under minimum size", group = "FVG")
maxBarsZoneToRetrace = input.int(60, "Max bars: zone -> retracement", minval = 1, group = "FVG")

useOB = input.bool(false, "Detect order blocks (not used in this video's examples)", group = "Order block")

entryZoneMode = input.string("FVG", "Entry zone", options = ["FVG", "OB", "Either"], group = "Entry")

targetMode = input.string("Liquidity", "Target mode", options = ["Liquidity", "R:R"], group = "Target / framework",
 tooltip = "\"Both\" isn't offered here since a backtest needs one definite exit price -- use the indicator's \"Both\" mode to compare them visually first, then pick one to backtest.")
targetRR = input.float(2.0, "Target R:R (if R:R)", minval = 0.1, step = 0.25, group = "Target / framework")
instrumentType = input.string("Forex", "Instrument type", options = ["Forex", "Index Futures/Other"], group = "Target / framework")
minFrameworkPips = input.float(15, "Minimum framework (pips, Forex)", minval = 0, group = "Target / framework")
minFrameworkPoints = input.float(10, "Minimum framework (points, Index Futures/Other)", minval = 0, group = "Target / framework")
pipSizeOverride = input.float(0, "Manual pip size override (0 = auto: mintick x 10)", minval = 0, group = "Target / framework")

stopMethod = input.string("Zone edge", "Stop method", options = ["Zone edge", "Swing point"], group = "Risk")
stopBufferAtrMult = input.float(0.15, "Stop buffer beyond level (x ATR)", minval = 0, group = "Risk")
riskPct = input.float(1.0, "Risk per trade (% of equity)", minval = 0.01, maxval = 100, group = "Risk")

showLiquidity    = input.bool(true, "Show liquidity levels", group = "Visuals")
showSweep        = input.bool(true, "Show sweeps", group = "Visuals")
showBOS          = input.bool(true, "Show BOS", group = "Visuals")
showDisplacement = input.bool(false, "Show displacement", group = "Visuals")
showFVG          = input.bool(true, "Show FVG zones", group = "Visuals")
showOB           = input.bool(true, "Show OB zones", group = "Visuals")
showEntry        = input.bool(true, "Show entries", group = "Visuals")
showInvalidation = input.bool(false, "Show invalidations", group = "Visuals")
showKillzoneBg   = input.bool(false, "Shade active killzone windows on chart", group = "Visuals")
showKillzoneLines = input.bool(true, "Show killzone start/end vertical lines", group = "Visuals")
showSilverBulletBanner = input.bool(true, "Show \"SILVER BULLET ZONE\" banner", group = "Visuals")
restrictToKillzone = input.bool(true, "Only draw sweep/timeout signals inside killzone windows", group = "Visuals")
lookbackDays = input.int(0, "History to display (days, 0 = show all)", minval = 0, group = "Visuals",
 tooltip = "Display only -- Strategy Tester always uses full history regardless of this setting.")

colLiquidity    = color.new(color.yellow, 40)
colBull         = color.green
colBear         = color.red
colBOS          = color.blue
colFVGbull      = color.new(color.aqua, 40)
colFVGbear      = color.new(color.fuchsia, 40)
colOBbull       = color.new(color.teal, 50)
colOBbear       = color.new(color.maroon, 50)
colEntry        = color.new(color.yellow, 0)
colInvalid      = color.new(color.red, 0)
colLiqBuySide   = color.new(#fa451c, 0)
colLiqSellSide  = color.new(#1ce4fa, 0)

// =====================================================================================
// SESSION WINDOWS
// =====================================================================================
win1Active = win1On and not na(time(timeframe.period, win1Session, tz))
win2Active = win2On and not na(time(timeframe.period, win2Session, tz))
win3Active = win3On and not na(time(timeframe.period, win3Session, tz))
anyWindowActive = win1Active or win2Active or win3Active

bgcolor(showKillzoneBg and anyWindowActive ? color.new(color.blue, 92) : na, title = "Killzone shading")

withinLookback = lookbackDays <= 0 or time >= timenow - lookbackDays * 86400000
showKZ = not restrictToKillzone or anyWindowActive

// ---- Killzone start/end vertical lines + "SILVER BULLET ZONE" banner ----
if showKillzoneLines and withinLookback and anyWindowActive and not anyWindowActive[1]
    line.new(bar_index, close, bar_index, close + 1, color = color.new(color.gray, 40), style = line.style_dashed, extend = extend.both)
if showKillzoneLines and withinLookback and not anyWindowActive and anyWindowActive[1]
    line.new(bar_index, close, bar_index, close + 1, color = color.new(color.gray, 40), style = line.style_dashed, extend = extend.both)

var int   kzBannerStartBar = na
var float kzBannerLow = na
var label kzBannerLbl = na
var bool  setupAttemptedThisWindow = false
if anyWindowActive
    if not anyWindowActive[1]
        kzBannerStartBar := bar_index
        kzBannerLow := low
    else
        kzBannerLow := math.min(kzBannerLow, low)
    if showSilverBulletBanner and withinLookback
        label.delete(kzBannerLbl)
        kzBannerLbl := label.new(int(math.avg(kzBannerStartBar, bar_index)), kzBannerLow - kzBannerLow * 0.0006, "SILVER BULLET ZONE", color = color.new(color.black, 15), textcolor = color.white, style = label.style_label_up, size = size.normal)
// Reset "one attempt" tracking the moment a window CLOSES (not when it opens) -- lets a
// sweep/BOS/FVG that forms in the gap before the next window still count as a fresh attempt.
if not anyWindowActive and anyWindowActive[1]
    setupAttemptedThisWindow := false

// =====================================================================================
// ATR / pip size
// =====================================================================================
atrVal = ta.atr(atrLen)
pipSize = pipSizeOverride != 0 ? pipSizeOverride : syminfo.mintick * 10
requiredFrameworkDist = instrumentType == "Forex" ? minFrameworkPips * pipSize : minFrameworkPoints

// =====================================================================================
// LIQUIDITY: swing highs/lows
// =====================================================================================
ph = ta.pivothigh(swingLeft, swingRight)
pl = ta.pivotlow(swingLeft, swingRight)

var float lastSwingHigh = na
var int   lastSwingHighBar = na
var float prevSwingHigh = na
var float lastSwingLow = na
var int   lastSwingLowBar = na
var float prevSwingLow = na

if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph
    lastSwingHighBar := bar_index - swingRight
if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl
    lastSwingLowBar := bar_index - swingRight

if showLiquidity and not na(ph) and withinLookback
    line.new(lastSwingHighBar, ph, bar_index, ph, color = colLiquidity, style = line.style_dotted)
if showLiquidity and not na(pl) and withinLookback
    line.new(lastSwingLowBar, pl, bar_index, pl, color = colLiquidity, style = line.style_dotted)

eqTol = atrVal * eqTolAtrFrac
eqHigh = useEqualHL and not na(lastSwingHigh) and not na(prevSwingHigh) and math.abs(lastSwingHigh - prevSwingHigh) <= eqTol ? math.max(lastSwingHigh, prevSwingHigh) : na
eqLow  = useEqualHL and not na(lastSwingLow)  and not na(prevSwingLow)  and math.abs(lastSwingLow  - prevSwingLow)  <= eqTol ? math.min(lastSwingLow, prevSwingLow)   : na

// =====================================================================================
// STRUCTURE ZIGZAG, ported from LuxAlgo's ICT Concepts [LuxAlgo] `draw()` function. Their single
// shared zigzag point array (built here independently of the swingLeft/swingRight pivots above,
// using LuxAlgo's own faster 1-bar-confirm pivots) feeds two things below: buy-side/sell-side
// liquidity clustering (3+ nearby swing points of the same direction within an ATR-based margin,
// grouped into a single box instead of one swing line), and the BOS reference-level indexing
// further down (their `iH`/`iL`) -- both additive/optional via their own toggles, alongside the
// single-swing-point liquidity and BOS already tracked above.
type liqZone
    box   bx
    line  ln

liqAtr10 = ta.atr(10)
liqMarginPx = liqAtr10 / (10 / liqClusterMargin)
liqPh = ta.pivothigh(liqClusterZZLen, 1)
liqPl = ta.pivotlow(liqClusterZZLen, 1)

var int[]     liqZZd = array.new<int>(50, 0)
var int[]     liqZZx = array.new<int>(50, 0)
var float[]   liqZZy = array.new<float>(50, na)
var liqZone[] liqBuyBoxes  = array.new<liqZone>()
var liqZone[] liqSellBoxes = array.new<liqZone>()

f_liqZZPush(dir, x2, y2) =>
    liqZZd.unshift(dir)
    liqZZx.unshift(x2)
    liqZZy.unshift(y2)
    liqZZd.pop()
    liqZZx.pop()
    liqZZy.pop()

if useLiqCluster or useFastBOS
    if not na(liqPh)
        pivDir = liqZZd.get(0)
        pivY1  = liqZZy.get(0)
        pivX2  = bar_index - 1
        pivY2  = nz(high[1])
        if pivDir < 1
            f_liqZZPush(1, pivX2, pivY2)
        else if liqPh > pivY1
            liqZZx.set(0, pivX2)
            liqZZy.set(0, pivY2)
        if useLiqCluster and withinLookback
            count = 0
            stB = 0
            stP = 0.0
            minP = 0.0
            maxP = 10e6
            for i = 0 to math.min(liqZZd.size(), 50) - 1
                if liqZZd.get(i) == 1
                    if liqZZy.get(i) > liqPh + liqMarginPx
                        break
                    else if liqZZy.get(i) > liqPh - liqMarginPx and liqZZy.get(i) < liqPh + liqMarginPx
                        count += 1
                        stB := liqZZx.get(i)
                        stP := liqZZy.get(i)
                        if liqZZy.get(i) > minP
                            minP := liqZZy.get(i)
                        if liqZZy.get(i) < maxP
                            maxP := liqZZy.get(i)
            if count > 2
                if liqBuyBoxes.size() > 0 and stB == liqBuyBoxes.get(0).bx.get_left()
                    buyZone0 = liqBuyBoxes.get(0)
                    buyZone0.bx.set_top(math.avg(minP, maxP) + liqMarginPx)
                    buyZone0.bx.set_rightbottom(bar_index + 10, math.avg(minP, maxP) - liqMarginPx)
                else
                    newBuyBox = box.new(stB, math.avg(minP, maxP) + liqMarginPx, bar_index + 10, math.avg(minP, maxP) - liqMarginPx,
                     border_color = color(na), bgcolor = color(na), text = "Buyside liquidity", text_size = size.tiny,
                     text_halign = text.align_left, text_valign = text.align_bottom, text_color = color.new(colLiqBuySide, 25))
                    newBuyLine = line.new(stB, stP, bar_index - 1, stP, color = colLiqBuySide)
                    liqBuyBoxes.unshift(liqZone.new(newBuyBox, newBuyLine))
                    if liqBuyBoxes.size() > liqClusterVisBoxes
                        oldBuy = liqBuyBoxes.pop()
                        box.delete(oldBuy.bx)
                        line.delete(oldBuy.ln)
    if not na(liqPl)
        pivDirL = liqZZd.get(0)
        pivY1L  = liqZZy.get(0)
        pivX2L  = bar_index - 1
        pivY2L  = nz(low[1])
        if pivDirL > -1
            f_liqZZPush(-1, pivX2L, pivY2L)
        else if liqPl < pivY1L
            liqZZx.set(0, pivX2L)
            liqZZy.set(0, pivY2L)
        if useLiqCluster and withinLookback
            countL = 0
            stBL = 0
            stPL = 0.0
            minPL = 0.0
            maxPL = 10e6
            for i = 0 to math.min(liqZZd.size(), 50) - 1
                if liqZZd.get(i) == -1
                    if liqZZy.get(i) < liqPl - liqMarginPx
                        break
                    else if liqZZy.get(i) > liqPl - liqMarginPx and liqZZy.get(i) < liqPl + liqMarginPx
                        countL += 1
                        stBL := liqZZx.get(i)
                        stPL := liqZZy.get(i)
                        if liqZZy.get(i) > minPL
                            minPL := liqZZy.get(i)
                        if liqZZy.get(i) < maxPL
                            maxPL := liqZZy.get(i)
            if countL > 2
                if liqSellBoxes.size() > 0 and stBL == liqSellBoxes.get(0).bx.get_left()
                    sellZone0 = liqSellBoxes.get(0)
                    sellZone0.bx.set_top(math.avg(minPL, maxPL) + liqMarginPx)
                    sellZone0.bx.set_rightbottom(bar_index + 10, math.avg(minPL, maxPL) - liqMarginPx)
                else
                    newSellBox = box.new(stBL, math.avg(minPL, maxPL) + liqMarginPx, bar_index + 10, math.avg(minPL, maxPL) - liqMarginPx,
                     border_color = color(na), bgcolor = color(na), text = "Sellside liquidity", text_size = size.tiny,
                     text_halign = text.align_left, text_valign = text.align_bottom, text_color = color.new(colLiqSellSide, 25))
                    newSellLine = line.new(stBL, stPL, bar_index - 1, stPL, color = colLiqSellSide)
                    liqSellBoxes.unshift(liqZone.new(newSellBox, newSellLine))
                    if liqSellBoxes.size() > liqClusterVisBoxes
                        oldSell = liqSellBoxes.pop()
                        box.delete(oldSell.bx)
                        line.delete(oldSell.ln)

liqBuyBot  = useLiqCluster and liqBuyBoxes.size()  > 0 ? box.get_bottom(liqBuyBoxes.get(0).bx)  : na
liqSellTop = useLiqCluster and liqSellBoxes.size() > 0 ? box.get_top(liqSellBoxes.get(0).bx)    : na

// =====================================================================================
// LIQUIDITY: previous day / previous week / session ranges / NWOG
// =====================================================================================
prevDayHigh  = usePrevDayHL  ? request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_off) : na
prevDayLow   = usePrevDayHL  ? request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_off) : na
prevWeekHigh = usePrevWeekHL ? request.security(syminfo.tickerid, "W", high[1],  lookahead = barmerge.lookahead_off) : na
prevWeekLow  = usePrevWeekHL ? request.security(syminfo.tickerid, "W", low[1],   lookahead = barmerge.lookahead_off) : na

// Merged from the user-supplied FeraTrading Sessions High/Low indicator, behavior preserved as-is:
// NY shows only the previously-completed NY session (frozen, snapshotted at the 18:00 NY reset).
// Tokyo and London instead draw LIVE -- their line/label update in real time as new highs/lows
// form during the session, then freeze once that session ends, until wiped at the next 18:00 reset.
isNewDay     = not na(time(timeframe.period, "1800-1801", tz))
nyActive     = not na(time(timeframe.period, nySession, tz))
tokyoActive  = not na(time(timeframe.period, tokyoSession, tz))
londonActive = not na(time(timeframe.period, londonSession, tz))

// ---- NY: snapshot the completed session at the daily reset, show only that frozen previous session ----
var float nyHigh = na
var float nyLow = na
var int   nyHighBar = na
var int   nyLowBar = na
var float prevNyHigh = na
var float prevNyLow = na
var int   prevNyHighBar = na
var int   prevNyLowBar = na
var line  nyHighLine = na
var line  nyLowLine = na
var label nyHighLbl = na
var label nyLowLbl = na

if isNewDay
    prevNyHigh := nyHigh
    prevNyLow := nyLow
    prevNyHighBar := nyHighBar
    prevNyLowBar := nyLowBar
    nyHigh := na
    nyLow := na
    nyHighBar := na
    nyLowBar := na
    line.delete(nyHighLine)
    line.delete(nyLowLine)
    nyHighLine := na
    nyLowLine := na

if nyActive
    if na(nyHigh) or high > nyHigh
        nyHigh := high
        nyHighBar := bar_index
    if na(nyLow) or low < nyLow
        nyLow := low
        nyLowBar := bar_index

if not na(prevNyHigh)
    if na(nyHighLine)
        nyHighLine := line.new(prevNyHighBar, prevNyHigh, bar_index, prevNyHigh, color = nyColor)
    line.set_xy2(nyHighLine, bar_index + lineExtender, prevNyHigh)
    if showSessionLabels
        label.delete(nyHighLbl)
        nyHighLbl := label.new(bar_index + lineExtender, prevNyHigh, "NY High", style = label.style_label_left, color = color.new(nyColor, 0), textcolor = sessionLabelColor, size = size.tiny)
if not na(prevNyLow)
    if na(nyLowLine)
        nyLowLine := line.new(prevNyLowBar, prevNyLow, bar_index, prevNyLow, color = nyColor)
    line.set_xy2(nyLowLine, bar_index + lineExtender, prevNyLow)
    if showSessionLabels
        label.delete(nyLowLbl)
        nyLowLbl := label.new(bar_index + lineExtender, prevNyLow, "NY Low", style = label.style_label_left, color = color.new(nyColor, 0), textcolor = sessionLabelColor, size = size.tiny)

// ---- Tokyo: live-updating during the session, freezes once it ends, cleared at the next reset ----
var float tokyoHigh = na
var float tokyoLow = na
var int   tokyoHighBar = na
var int   tokyoLowBar = na
var line  tokyoHighLine = na
var line  tokyoLowLine = na
var label tokyoHighLbl = na
var label tokyoLowLbl = na

if isNewDay
    tokyoHigh := na
    tokyoLow := na
    tokyoHighBar := na
    tokyoLowBar := na
    line.delete(tokyoHighLine)
    line.delete(tokyoLowLine)
    tokyoHighLine := na
    tokyoLowLine := na

if tokyoActive
    if na(tokyoHigh) or high > tokyoHigh
        tokyoHigh := high
        tokyoHighBar := bar_index
        line.delete(tokyoHighLine)
        tokyoHighLine := line.new(tokyoHighBar, tokyoHigh, bar_index, tokyoHigh, color = tokyoColor)
    if na(tokyoLow) or low < tokyoLow
        tokyoLow := low
        tokyoLowBar := bar_index
        line.delete(tokyoLowLine)
        tokyoLowLine := line.new(tokyoLowBar, tokyoLow, bar_index, tokyoLow, color = tokyoColor)

if not na(tokyoHighLine)
    line.set_xy2(tokyoHighLine, bar_index + lineExtender, tokyoHigh)
if not na(tokyoLowLine)
    line.set_xy2(tokyoLowLine, bar_index + lineExtender, tokyoLow)
if showSessionLabels
    if not na(tokyoHigh)
        label.delete(tokyoHighLbl)
        tokyoHighLbl := label.new(bar_index + lineExtender, tokyoHigh, "Tokyo High", style = label.style_label_left, color = color.new(tokyoColor, 0), textcolor = sessionLabelColor, size = size.tiny)
    if not na(tokyoLow)
        label.delete(tokyoLowLbl)
        tokyoLowLbl := label.new(bar_index + lineExtender, tokyoLow, "Tokyo Low", style = label.style_label_left, color = color.new(tokyoColor, 0), textcolor = sessionLabelColor, size = size.tiny)

// ---- London: same live-updating pattern as Tokyo ----
var float londonHigh = na
var float londonLow = na
var int   londonHighBar = na
var int   londonLowBar = na
var line  londonHighLine = na
var line  londonLowLine = na
var label londonHighLbl = na
var label londonLowLbl = na

if isNewDay
    londonHigh := na
    londonLow := na
    londonHighBar := na
    londonLowBar := na
    line.delete(londonHighLine)
    line.delete(londonLowLine)
    londonHighLine := na
    londonLowLine := na

if londonActive
    if na(londonHigh) or high > londonHigh
        londonHigh := high
        londonHighBar := bar_index
        line.delete(londonHighLine)
        londonHighLine := line.new(londonHighBar, londonHigh, bar_index, londonHigh, color = londonColor)
    if na(londonLow) or low < londonLow
        londonLow := low
        londonLowBar := bar_index
        line.delete(londonLowLine)
        londonLowLine := line.new(londonLowBar, londonLow, bar_index, londonLow, color = londonColor)

if not na(londonHighLine)
    line.set_xy2(londonHighLine, bar_index + lineExtender, londonHigh)
if not na(londonLowLine)
    line.set_xy2(londonLowLine, bar_index + lineExtender, londonLow)
if showSessionLabels
    if not na(londonHigh)
        label.delete(londonHighLbl)
        londonHighLbl := label.new(bar_index + lineExtender, londonHigh, "London High", style = label.style_label_left, color = color.new(londonColor, 0), textcolor = sessionLabelColor, size = size.tiny)
    if not na(londonLow)
        label.delete(londonLowLbl)
        londonLowLbl := label.new(bar_index + lineExtender, londonLow, "London Low", style = label.style_label_left, color = color.new(londonColor, 0), textcolor = sessionLabelColor, size = size.tiny)

var float nwogTop = na
var float nwogBot = na
newWeek = ta.change(time("W")) != 0
if useNWOG and newWeek
    nwogTop := math.max(open, close[1])
    nwogBot := math.min(open, close[1])

// =====================================================================================
// LIQUIDITY: FVG-as-target tracking
// =====================================================================================
bullFVGraw = low > high[2]
bearFVGraw = high < low[2]

var float lastBullFvgTop = na
var float lastBullFvgBot = na
var bool  lastBullFvgFilled = true
var float lastBearFvgTop = na
var float lastBearFvgBot = na
var bool  lastBearFvgFilled = true

if bullFVGraw
    lastBullFvgTop := low
    lastBullFvgBot := high[2]
    lastBullFvgFilled := false
if not lastBullFvgFilled and not na(lastBullFvgBot) and low < lastBullFvgBot
    lastBullFvgFilled := true

if bearFVGraw
    lastBearFvgTop := low[2]
    lastBearFvgBot := high
    lastBearFvgFilled := false
if not lastBearFvgFilled and not na(lastBearFvgTop) and high > lastBearFvgTop
    lastBearFvgFilled := true

// =====================================================================================
// NEAREST-LEVEL HELPERS
// =====================================================================================
f_nearestAbove(refPrice) =>
    float best = na
    if useSwingHL and not na(lastSwingHigh) and lastSwingHigh > refPrice
        best := lastSwingHigh
    if useEqualHL and not na(eqHigh) and eqHigh > refPrice and (na(best) or eqHigh < best)
        best := eqHigh
    if usePrevDayHL and not na(prevDayHigh) and prevDayHigh > refPrice and (na(best) or prevDayHigh < best)
        best := prevDayHigh
    if usePrevWeekHL and not na(prevWeekHigh) and prevWeekHigh > refPrice and (na(best) or prevWeekHigh < best)
        best := prevWeekHigh
    if useNYHL and not na(prevNyHigh) and prevNyHigh > refPrice and (na(best) or prevNyHigh < best)
        best := prevNyHigh
    if useTokyoHL and not na(tokyoHigh) and tokyoHigh > refPrice and (na(best) or tokyoHigh < best)
        best := tokyoHigh
    if useLondonHL and not na(londonHigh) and londonHigh > refPrice and (na(best) or londonHigh < best)
        best := londonHigh
    if useNWOG and not na(nwogTop) and nwogTop > refPrice and (na(best) or nwogTop < best)
        best := nwogTop
    if useFvgTarget and not lastBullFvgFilled and not na(lastBullFvgBot) and lastBullFvgBot > refPrice and (na(best) or lastBullFvgBot < best)
        best := lastBullFvgBot
    if useLiqCluster and not na(liqBuyBot) and liqBuyBot > refPrice and (na(best) or liqBuyBot < best)
        best := liqBuyBot
    best

f_nearestBelow(refPrice) =>
    float best = na
    if useSwingHL and not na(lastSwingLow) and lastSwingLow < refPrice
        best := lastSwingLow
    if useEqualHL and not na(eqLow) and eqLow < refPrice and (na(best) or eqLow > best)
        best := eqLow
    if usePrevDayHL and not na(prevDayLow) and prevDayLow < refPrice and (na(best) or prevDayLow > best)
        best := prevDayLow
    if usePrevWeekHL and not na(prevWeekLow) and prevWeekLow < refPrice and (na(best) or prevWeekLow > best)
        best := prevWeekLow
    if useNYHL and not na(prevNyLow) and prevNyLow < refPrice and (na(best) or prevNyLow > best)
        best := prevNyLow
    if useTokyoHL and not na(tokyoLow) and tokyoLow < refPrice and (na(best) or tokyoLow > best)
        best := tokyoLow
    if useLondonHL and not na(londonLow) and londonLow < refPrice and (na(best) or londonLow > best)
        best := londonLow
    if useNWOG and not na(nwogBot) and nwogBot < refPrice and (na(best) or nwogBot > best)
        best := nwogBot
    if useFvgTarget and not lastBearFvgFilled and not na(lastBearFvgTop) and lastBearFvgTop < refPrice and (na(best) or lastBearFvgTop > best)
        best := lastBearFvgTop
    if useLiqCluster and not na(liqSellTop) and liqSellTop < refPrice and (na(best) or liqSellTop > best)
        best := liqSellTop
    best

watchHigh = f_nearestAbove(close)
watchLow  = f_nearestBelow(close)

// =====================================================================================
// SWEEP
// =====================================================================================
sweepHighRaw = not na(watchHigh) and (sweepConfirm == "Wick" ? (high > watchHigh and close < watchHigh) : (close[1] > watchHigh and close < watchHigh))
sweepLowRaw  = not na(watchLow)  and (sweepConfirm == "Wick" ? (low  < watchLow  and close > watchLow)  : (close[1] < watchLow  and close > watchLow))
// Note: these two are "raw" -- true on every qualifying wick-rejection, even while a setup is
// already being tracked. The SWEEP label is only drawn on the bar that actually arms a NEW
// setup (see armHigh/armLow below), not on every raw occurrence -- otherwise minor rejections
// during an already-pending setup each drew their own label.

// =====================================================================================
// STATE MACHINE (states 0-6 identical to the indicator; state 7+ is replaced by a real
// strategy.entry/strategy.exit pair -- Strategy Tester manages the trade from there)
// =====================================================================================
var int   state = 0
var int   dir = 0
var int   sweepBar = na
var float sweptLevel = na
var float zoneTop = na
var float zoneBot = na
var string zoneType = ""
var int   zoneBar = na
var bool  zoneClosedOutside = false
var box   zoneBox = na
var label zoneLbl = na
var float targetLevel = na
var int   bosBar = na

// ---- arm on sweep (once per killzone window -- see setupAttemptedThisWindow below) ----
armHigh = state == 0 and not setupAttemptedThisWindow and sweepHighRaw and (not requireSweepInsideKZ or anyWindowActive)
armLow  = state == 0 and not setupAttemptedThisWindow and sweepLowRaw  and (not requireSweepInsideKZ or anyWindowActive)

if armHigh
    state := 2
    dir := -1
    sweepBar := bar_index
    sweptLevel := watchHigh
    setupAttemptedThisWindow := true
if armLow
    state := 2
    dir := 1
    sweepBar := bar_index
    sweptLevel := watchLow
    setupAttemptedThisWindow := true

if showSweep and armHigh and withinLookback and showKZ
    label.new(bar_index, high, "SWEEP", color = colInvalid, style = label.style_label_down, textcolor = color.white, size = size.tiny)
if showSweep and armLow and withinLookback and showKZ
    label.new(bar_index, low, "SWEEP", color = colBull, style = label.style_label_up, textcolor = color.white, size = size.tiny)

if state == 2 and bar_index - sweepBar > maxBarsSweepToBOS
    if showInvalidation and withinLookback and showKZ
        label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(no BOS)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
    state := 0
    dir := 0

// BOS reference level, ported from LuxAlgo's ICT Concepts [LuxAlgo] MSS/BOS indexing (their
// `iH`/`iL`): the nearest zigzag point of the needed direction that ISN'T the point that just
// formed -- reused from the same fast zigzag built above for liquidity clustering. Falls back to
// the slower Swing lookback pivot when useFastBOS is off.
bosIH = liqZZd.get(2) == 1  ? 2 : 1
bosIL = liqZZd.get(2) == -1 ? 2 : 1
bosLevelHigh    = not useFastBOS ? lastSwingHigh    : (liqZZd.get(bosIH) == 1  ? liqZZy.get(bosIH) : na)
bosLevelHighBar = not useFastBOS ? lastSwingHighBar : (liqZZd.get(bosIH) == 1  ? liqZZx.get(bosIH) : na)
bosLevelLow     = not useFastBOS ? lastSwingLow     : (liqZZd.get(bosIL) == -1 ? liqZZy.get(bosIL) : na)
bosLevelLowBar  = not useFastBOS ? lastSwingLowBar  : (liqZZd.get(bosIL) == -1 ? liqZZx.get(bosIL) : na)

// Window-gated: BOS only confirms while a killzone is active. (Reverted an earlier attempt to
// let BOS form before the window -- since sweeps aren't window-restricted by default either,
// that let sweep->BOS->FVG fire anywhere on the chart all day, not just near a killzone.)
bosUp   = dir == 1  and state == 2 and anyWindowActive and not na(bosLevelHigh) and (bar_index - sweepBar) <= sweepLookback and (bosConfirm == "Wick" ? high > bosLevelHigh : close > bosLevelHigh)
bosDown = dir == -1 and state == 2 and anyWindowActive and not na(bosLevelLow)  and (bar_index - sweepBar) <= sweepLookback and (bosConfirm == "Wick" ? low  < bosLevelLow  : close < bosLevelLow)

if bosUp or bosDown
    state := 3
    bosBar := bar_index
    if showBOS and withinLookback
        bosFromBar = bosUp ? bosLevelHighBar : bosLevelLowBar
        bosLevel = bosUp ? bosLevelHigh : bosLevelLow
        line.new(bosFromBar, bosLevel, bar_index, bosLevel, color = colBOS, style = line.style_arrow_right, width = 2)
        label.new(int(math.avg(bosFromBar, bar_index)), bosLevel, "BOS", color = color(na), textcolor = colBOS, style = bosUp ? label.style_label_down : label.style_label_up, size = size.small)

// Displacement quality test ported from LuxAlgo's ICT Concepts [LuxAlgo]: the gap-forming candle
// must have an above-average body, with wicks each under 36% of the body's own size.
luxBody = math.abs(close - open)
luxMeanBody = ta.sma(luxBody, dispBodyAvgLen)
luxMx = math.max(close, open)
luxMn = math.min(close, open)
luxL_body = (high - luxMx) < luxBody * 0.36 and (luxMn - low) < luxBody * 0.36
luxBodyUp = luxBody > luxMeanBody and luxL_body and close > open
luxBodyDn = luxBody > luxMeanBody and luxL_body and close < open

dispStrengthOk = not requireDisplacementFilter or (dir == 1 ? luxBodyUp[1] : luxBodyDn[1])
fvgSizeOk = not ignoreTinyFvg or (dir == 1 and (low - high[2]) >= atrVal * minFvgSizeAtrFrac) or (dir == -1 and (low[2] - high) >= atrVal * minFvgSizeAtrFrac)

// ---- keep checking every bar while state==3, for up to maxBarsBOStoFVG bars after the BOS bar --
// the imbalance doesn't always land on the exact bar structure broke on ----
if state == 3
    fvgHere = dir == 1 ? bullFVGraw : bearFVGraw
    obHere  = dir == 1 ? close[1] < open[1] : close[1] > open[1]
    if fvgHere and dispStrengthOk and fvgSizeOk and (entryZoneMode == "FVG" or entryZoneMode == "Either")
        zoneTop := dir == 1 ? low : low[2]
        zoneBot := dir == 1 ? high[2] : high
        zoneType := "FVG"
        zoneBar := bar_index
        zoneClosedOutside := false
        state := 4
        if showDisplacement and withinLookback
            label.new(bar_index, dir == 1 ? low : high, "DISPLACEMENT", color = dir == 1 ? colBull : colBear, style = dir == 1 ? label.style_label_up : label.style_label_down, textcolor = color.white, size = size.tiny)
    else if useOB and obHere and (entryZoneMode == "OB" or entryZoneMode == "Either")
        zoneTop := high[1]
        zoneBot := low[1]
        zoneType := "OB"
        zoneBar := bar_index
        zoneClosedOutside := false
        state := 4
        if showDisplacement and withinLookback
            label.new(bar_index, dir == 1 ? low : high, "DISPLACEMENT", color = dir == 1 ? colBull : colBear, style = dir == 1 ? label.style_label_up : label.style_label_down, textcolor = color.white, size = size.tiny)
    else if bar_index - bosBar >= maxBarsBOStoFVG
        if showInvalidation and withinLookback
            label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(no FVG/OB)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
        state := 0
        dir := 0

if state >= 4 and zoneBar == bar_index and withinLookback
    zoneLabel = (dir == 1 ? "FVG - BUY Zone" : "FVG - SELL Zone")
    if showFVG and zoneType == "FVG"
        zoneBox := box.new(zoneBar - 2, zoneTop, bar_index, zoneBot, border_color = dir == 1 ? colFVGbull : colFVGbear, bgcolor = dir == 1 ? colFVGbull : colFVGbear)
        zoneLbl := label.new(bar_index, math.avg(zoneTop, zoneBot), zoneLabel, color = color.new(color.black, 15), textcolor = color.white, style = label.style_label_center, size = size.small)
    if showOB and zoneType == "OB"
        zoneBox := box.new(zoneBar - 1, zoneTop, bar_index, zoneBot, border_color = dir == 1 ? colOBbull : colOBbear, bgcolor = dir == 1 ? colOBbull : colOBbear)
        zoneLbl := label.new(bar_index, math.avg(zoneTop, zoneBot), dir == 1 ? "OB - BUY Zone" : "OB - SELL Zone", color = color.new(color.black, 15), textcolor = color.white, style = label.style_label_center, size = size.small)

if state >= 4 and state < 7 and not na(zoneBox) and withinLookback
    box.set_right(zoneBox, bar_index)
    label.set_x(zoneLbl, int(math.avg(zoneBar, bar_index)))
    // Break-state border, ported from LuxAlgo's ICT Concepts [LuxAlgo]: dashed once price has
    // traded into the zone (still live, just being tested).
    touchedZoneBorder = dir == 1 ? low <= zoneTop : high >= zoneBot
    if touchedZoneBorder
        box.set_border_style(zoneBox, line.style_dashed)

if state == 4
    refEdge = dir == 1 ? zoneTop : zoneBot
    float candidateTarget = dir == 1 ? f_nearestAbove(refEdge) : f_nearestBelow(refEdge)
    float dist = na(candidateTarget) ? na : math.abs(candidateTarget - refEdge)
    frameworkOk = targetMode == "R:R" ? true : (not na(dist) and dist >= requiredFrameworkDist)
    if frameworkOk
        targetLevel := candidateTarget
        state := 5
    else
        if showInvalidation and withinLookback
            label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(framework too small)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
        state := 0
        dir := 0

if state == 5 and not zoneClosedOutside and bar_index > zoneBar
    outside = dir == 1 ? close > zoneTop : close < zoneBot
    if outside
        zoneClosedOutside := true
        state := 6

zoneFilled = state >= 5 and state < 8 and (dir == 1 ? low < zoneBot : high > zoneTop)

if state >= 5 and state < 7 and (bar_index - zoneBar) > maxBarsZoneToRetrace
    if showInvalidation and withinLookback
        label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(no retracement)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
    state := 0
    dir := 0

if state >= 5 and state < 7 and zoneFilled
    if showInvalidation and withinLookback
        label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(zone filled)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
    if not na(zoneBox)
        box.set_border_style(zoneBox, line.style_dotted)
        box.set_bgcolor(zoneBox, color.new(dir == 1 ? colFVGbull : colFVGbear, 90))
    state := 0
    dir := 0

// Edge-triggered (window just closed), not level-triggered -- a zone formed before its window
// opened must not be invalidated for simply not being in a window yet.
if invalidateOnWindowClose and state >= 3 and state < 7 and anyWindowActive[1] and not anyWindowActive
    if showInvalidation and withinLookback
        label.new(bar_index, dir == 1 ? high : low, "SETUP INVALIDATED\n(window closed)", color = colInvalid, style = dir == 1 ? label.style_label_down : label.style_label_up, textcolor = color.white, size = size.tiny)
    state := 0
    dir := 0

// =====================================================================================
// ENTRY -- places the actual order. Only when flat, so one Silver Bullet trade at a time.
// =====================================================================================
touchedZone = state == 6 and anyWindowActive and strategy.position_size == 0 and (dir == 1 ? (low <= zoneTop and low >= zoneBot) : (high >= zoneBot and high <= zoneTop))
if touchedZone
    entryLevel = dir == 1 ? zoneTop : zoneBot
    bufAtr = atrVal * stopBufferAtrMult
    stopLevel = stopMethod == "Zone edge" ? (dir == 1 ? zoneBot - bufAtr : zoneTop + bufAtr) : (dir == 1 ? sweptLevel - bufAtr : sweptLevel + bufAtr)
    riskUnit = math.abs(entryLevel - stopLevel)
    if riskUnit > 0
        finalTarget = targetMode == "R:R" ? (dir == 1 ? entryLevel + riskUnit * targetRR : entryLevel - riskUnit * targetRR) : targetLevel
        qty = strategy.equity * riskPct / 100 / riskUnit
        if dir == 1
            strategy.entry("SB Long", strategy.long, qty = qty)
            strategy.exit("SB Long Exit", "SB Long", stop = stopLevel, limit = finalTarget)
        else
            strategy.entry("SB Short", strategy.short, qty = qty)
            strategy.exit("SB Short Exit", "SB Short", stop = stopLevel, limit = finalTarget)
        if showEntry and withinLookback
            label.new(bar_index, entryLevel,
             (dir == 1 ? "BUY " : "SELL ") + str.tostring(entryLevel, format.mintick) +
             "\nStop " + str.tostring(stopLevel, format.mintick) +
             "\nTarget " + str.tostring(finalTarget, format.mintick),
             color = dir == 1 ? colBull : colBear, style = dir == 1 ? label.style_label_up : label.style_label_down, textcolor = color.white, size = size.small)
    state := 0
    dir := 0

// =====================================================================================
// STATS: win rate + realized R:R + breakeven R:R (same framework as rr-backtester.pine)
// =====================================================================================
totalTrades = strategy.closedtrades
wins        = strategy.wintrades
losses      = strategy.losstrades

winRate    = totalTrades > 0 ? wins / totalTrades * 100 : na
avgWin     = wins   > 0 ? strategy.grossprofit / wins   : na
avgLoss    = losses > 0 ? strategy.grossloss   / losses : na
realizedRR = (not na(avgWin)) and (not na(avgLoss)) and avgLoss != 0 ? avgWin / math.abs(avgLoss) : na

wrFrac      = totalTrades > 0 ? wins / totalTrades : na
breakevenRR = (not na(wrFrac)) and wrFrac > 0 ? (1 - wrFrac) / wrFrac : na
expectancyR = (not na(wrFrac)) and targetMode == "R:R" ? wrFrac * targetRR - (1 - wrFrac) : na

profitFactor = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na

var table perfTb = table.new(position.bottom_right, 2, 8, border_width = 1)

f_row(_row, _label, _val) =>
    table.cell(perfTb, 0, _row, _label, text_halign = text.align_left,  bgcolor = color.new(color.gray, 80), text_color = color.white)
    table.cell(perfTb, 1, _row, _val,   text_halign = text.align_right, bgcolor = color.new(color.gray, 80), text_color = color.white)

if barstate.islast
    f_row(0, "Closed trades",        str.tostring(totalTrades))
    f_row(1, "Win rate",             na(winRate) ? "n/a" : str.tostring(winRate, "#.##") + "%")
    f_row(2, "Realized R:R (avg)",   na(realizedRR) ? "n/a" : str.tostring(realizedRR, "#.##"))
    f_row(3, "Breakeven R:R needed", na(breakevenRR) ? "n/a" : str.tostring(breakevenRR, "#.##"))
    f_row(4, "Expectancy",           na(expectancyR) ? "n/a" : str.tostring(expectancyR, "#.###") + " R/trade")
    f_row(5, "Profit factor",        na(profitFactor) ? "n/a" : str.tostring(profitFactor, "#.##"))
    f_row(6, "Net profit",           str.tostring(strategy.netprofit, "#.##"))
    f_row(7, "Target mode",          targetMode + (targetMode == "R:R" ? " (" + str.tostring(targetRR, "#.##") + ")" : ""))
