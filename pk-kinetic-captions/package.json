{
  "name": "@pkvisuals/pk-kinetic-captions",
  "version": "1.1.0",
  "description": "PK Kinetic Captions — a kinetic typography system for Final Cut Pro. Turns a transcript into designed motion typography.",
  "author": "PK Visuals",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "pkkc": "./bin/pkkc.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine/compose.js",
    "./templates": "./src/templates/schema.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "ui": "node bin/pkkc.js ui",
    "install-templates": "node bin/pkkc.js install",
    "demo": "node bin/pkkc.js demo --out ./examples/out"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.6.3"
  }
}
