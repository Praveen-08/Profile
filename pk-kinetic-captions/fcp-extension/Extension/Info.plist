    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.FinalCut.WorkflowExtension</string>
    <key>NSExtensionPrincipalClass</key>
    <string>$(PRODUCT_MODULE_NAME).PKCaptionsViewController</string>
    <key>NSExtensionAttributes</key>
    <dict>
      <key>ProExtensionPrincipalClass</key>
      <string>$(PRODUCT_MODULE_NAME).PKCaptionsViewController</string>
      <key>ProExtensionPrincipalViewControllerClass</key>
      <string>$(PRODUCT_MODULE_NAME).PKCaptionsViewController</string>
      <key>ProExtensionHostDisplayName</key>
      <string>Final Cut Pro</string>
      <key>ProExtensionHostBundleIdentifier</key>
      <string>com.apple.FinalCut</string>
    </dict>
  </dict>
</dict>
</plist>
